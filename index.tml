<!DOCTYPE html>
<html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Gallery NEXT BETTER – Read. Learn. Grow.</title><meta name="description" content="Perpustakaan dan toko ebook digital: baca gratis dan koleksi premium.">
<!-- NEXT BETTER (1 file). Backend: Supabase. Jalankan supabase/migration.sql, buat bucket book-covers (public) & book-files (private), deploy Edge Function read-book, lalu isi akun admin di tabel admin_users. -->
<link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>:root{font-family:'Plus Jakarta Sans',system-ui,sans-serif;--r:16px}
*{box-sizing:border-box}
body{--iv:#f4eee3;--w:#fffdf8;--ch:#241d15;--mg:#7d7466;--gd:#c49a50;--bg2:#e6dcc7;--hd:#1c150e;--pri:#241d15;--onpri:#f4eee3;--rd:#c49a50;--onrd:#1c150e;margin:0;background:var(--iv);color:var(--ch);line-height:1.55;overflow-x:hidden}
body[data-page=index]{--iv:#0b1020;--w:#131a38;--ch:#eceffb;--mg:#97a0c4;--gd:#d6b36a;--bg2:#252e58;--hd:#0b1020;--pri:#d6b36a;--onpri:#1a1405;--rd:#5a63d8;--onrd:#fff;background:radial-gradient(900px 480px at 85% -5%,#2a3a8a55,transparent),radial-gradient(700px 400px at 0 25%,#4a2a8a30,transparent),#0b1020}
body[data-page=admin]{--iv:#121212;--w:#1b1a18;--ch:#f1ece2;--mg:#9a948a;--gd:#d1a954;--bg2:#2b2924;--hd:#121212;--pri:#d1a954;--onpri:#1a1405;--rd:#d1a954;--onrd:#1a1405}
body[data-page=admin][data-light]{--iv:#f3efe6;--w:#fff;--ch:#241d15;--mg:#7d7466;--bg2:#e6dcc7}
h1,h2,h3{line-height:1.2;margin:0 0 .5em;letter-spacing:-.02em}h1{font-size:clamp(1.7rem,5vw,2.6rem)}h2{font-size:1.4rem}a{color:inherit}img{max-width:100%;display:block}
.wrap{max-width:1180px;margin:auto;padding:0 16px}.main{padding-top:26px;padding-bottom:50px;min-height:55vh}.mut{color:var(--mg)}.ctr{text-align:center}
:focus-visible{outline:3px solid var(--gd);outline-offset:2px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;background:var(--pri);color:var(--onpri);border:1px solid transparent;border-radius:12px;padding:10px 18px;font:700 .9rem inherit;font-family:inherit;text-decoration:none;cursor:pointer;transition:.2s}.btn:hover{filter:brightness(1.1)}.btn.rd{background:var(--rd);color:var(--onrd)}.btn.ghost{background:transparent;color:var(--ch);border-color:var(--bg2)}.btn.sm{padding:8px 12px;font-size:.82rem;border-radius:10px}.btn.dg{background:#9b2c2c;color:#fff}.btn:disabled{opacity:.6}
header{position:sticky;top:0;z-index:30;background:var(--hd);color:#eceff7;border-bottom:1px solid #ffffff14}
.nv{display:flex;align-items:center;gap:14px;height:64px}.logo{display:flex;align-items:center;gap:10px;text-decoration:none}.logo svg{color:var(--gd);width:30px;height:30px}.logo span{display:grid;line-height:1.05}.logo b{letter-spacing:.22em;font-size:1.05rem}.logo small{letter-spacing:.38em;font-size:.58rem;color:var(--gd)}
#mn{display:flex;gap:2px;margin:0 auto;align-items:center}#mn a{padding:21px 14px;text-decoration:none;color:#b9bdd2;font-weight:500;font-size:.92rem}#mn a:hover,#mn a.on{color:#fff}#mn a.on{box-shadow:inset 0 -3px var(--gd)}
.ns{display:flex;align-items:center;background:#ffffff12;border:1px solid #ffffff22;border-radius:99px;padding:0 6px 0 14px;width:290px}.ns input{border:0;background:none;outline:0;color:#fff;flex:1;min-width:0;padding:9px 0;font:inherit;font-size:.85rem}.ns input::placeholder{color:#9aa0bd}
.ib{background:none;border:0;width:40px;height:40px;border-radius:50%;cursor:pointer;color:inherit;display:grid;place-items:center}.mt,.msr{display:none}
.ua{display:flex;gap:8px;align-items:center}.um{position:relative}.um summary{list-style:none;cursor:pointer;display:flex;align-items:center;gap:8px}.um summary::-webkit-details-marker{display:none}.av{width:38px;height:38px;border-radius:50%;border:1px solid #ffffff33;background:#ffffff14;color:var(--gd);display:grid;place-items:center;font-weight:800}.un{max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.85rem}
.dd{position:absolute;right:0;top:46px;background:var(--w);color:var(--ch);border:1px solid var(--bg2);border-radius:14px;padding:8px;min-width:210px;display:grid;box-shadow:0 14px 34px rgba(0,0,0,.3)}.dd a,.dd button{padding:10px 12px;text-align:left;background:none;border:0;font:inherit;color:inherit;text-decoration:none;border-radius:8px;cursor:pointer}.dd a:hover,.dd button:hover{background:var(--bg2)}
.hm{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:18px;padding-top:20px;padding-bottom:50px}
.hero{position:relative;overflow:hidden;border-radius:22px;border:1px solid var(--bg2);min-height:310px;padding:30px;display:flex;flex-direction:column;justify-content:center;background:linear-gradient(180deg,#121a50 0%,#3a2a78 52%,#c97b52 100%)}
.hero::before{content:"";position:absolute;inset:auto 0 0 0;height:52%;background:#0b1020;clip-path:polygon(0 70%,12% 45%,24% 62%,38% 28%,52% 55%,66% 20%,80% 50%,92% 35%,100% 55%,100% 100%,0 100%);opacity:.92}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0b1020e6 0%,#0b102066 55%,transparent)}.hero>*{position:relative;z-index:2}
.eb{color:var(--gd);letter-spacing:.2em;font-size:.72rem;font-weight:700}.gt{background:linear-gradient(90deg,#7f8bff,#b79cff);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{max-width:44ch;color:#c9cde6;margin:0 0 18px}
.hs{display:flex;background:#0b1020cc;border:1px solid #ffffff2a;border-radius:14px;padding:5px;max-width:480px}.hs input{flex:1;min-width:0;border:0;background:none;color:#fff;padding:9px 12px;outline:0;font:inherit}.hs button{border:0;border-radius:10px;background:var(--rd);color:#fff;width:42px;cursor:pointer}
.promo{border:1px solid var(--bg2);border-radius:22px;padding:24px;position:relative;overflow:hidden;background:linear-gradient(160deg,#1b2266,#0f1430 62%);min-height:220px}.promo h3{font-size:1.35rem;margin-bottom:10px}.promo p{color:#b9bedc;font-size:.9rem;max-width:20ch}.promo .bs{position:absolute;right:-8px;bottom:-14px;width:150px;height:130px;background:linear-gradient(135deg,#3a46c8,#1a1f5a);border-radius:10px;transform:rotate(-12deg);box-shadow:-24px 12px 0 #232a7a,-46px 22px 0 #171c52;opacity:.85}
.ctabs{display:flex;gap:4px;overflow-x:auto;background:var(--w);border:1px solid var(--bg2);border-radius:18px;padding:8px;scrollbar-width:none}.ctabs::-webkit-scrollbar{display:none}.ctab{flex:none;min-width:84px;display:grid;justify-items:center;gap:4px;padding:10px 8px;background:none;border:0;border-radius:14px;color:var(--mg);font:600 .78rem inherit;cursor:pointer}.ctab.on{background:linear-gradient(180deg,#5a63d8,#3f46a8);color:#fff}
.shd{display:flex;justify-content:space-between;align-items:flex-end;gap:10px;flex-wrap:wrap;margin:22px 0 14px}.pill{display:inline-block;border:1px solid var(--bg2);color:var(--gd);letter-spacing:.18em;font-size:.65rem;font-weight:700;padding:3px 10px;border-radius:6px;margin-bottom:6px}.shd h2{font-size:1.8rem;margin:0}.shd p{margin:2px 0 0;color:var(--mg)}.shr{display:flex;gap:10px;align-items:center;font-size:.85rem}.shr select{width:auto}
.card,.pop{background:var(--w);border:1px solid var(--bg2);border-radius:22px;padding:18px}.ph{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}.ph a{color:var(--gd);font-size:.8rem;text-decoration:none}
.pi{display:grid;grid-template-columns:28px 44px 1fr;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid var(--bg2)}.pi:last-child{border:0}.rk{width:28px;height:28px;border-radius:50%;background:var(--bg2);display:grid;place-items:center;font-size:.8rem;font-weight:700}.pi .cvr{width:44px;box-shadow:none;border-radius:4px}.pi b{font-size:.88rem;display:block;line-height:1.25}.pi small{color:var(--mg)}.bst{background:#d6b36a26;color:var(--gd);border-radius:99px;font-size:.66rem;padding:1px 8px;font-weight:700}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:16px}.grid.ls{grid-template-columns:1fr}.grid.ls .bc{flex-direction:row}.grid.ls .cvr{width:110px;flex:none}.grid.ls .bi{flex:1}
.bc{background:var(--w);border:1px solid var(--bg2);border-radius:18px;padding:12px;display:flex;flex-direction:column;gap:10px;transition:.2s}.bc:hover{transform:translateY(-3px);border-color:var(--gd)}
.cvr{position:relative;display:block;aspect-ratio:2/3;border-radius:10px;overflow:hidden;background:var(--bg2);box-shadow:0 8px 20px rgba(0,0,0,.25)}.cvr img{width:100%;height:100%;object-fit:cover}
.nc{height:100%;padding:14px;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;background:linear-gradient(160deg,#27305f,#10152e);color:#eceffb;font-weight:800;line-height:1.2}.nc svg{color:var(--gd);width:32px;height:32px}
.tg{position:absolute;top:8px;left:8px;font-size:.68rem;font-weight:700;padding:3px 10px;border-radius:99px}.tg.p{background:#d6b36a;color:#1a1405}.tg.f{background:#2f9e6f;color:#fff}.tg.st{position:static;display:inline-block}
.bi{display:grid;gap:4px;align-content:start}.bi h3{font-size:1rem;margin:0}.bi h3 a{text-decoration:none}.au{color:var(--mg)}.chip{display:inline-block;background:var(--bg2);color:var(--mg);border-radius:99px;padding:2px 10px;font-size:.72rem;justify-self:start}
.rt{display:flex;gap:4px;align-items:center;font-size:.82rem}.rt svg{width:14px;height:14px;fill:var(--gd);color:var(--gd)}.rt small{color:var(--mg)}.pr{font-weight:800;color:var(--gd)}.pr.xl{font-size:1.5rem}.ac{display:flex;gap:8px;margin-top:6px}.ac .btn{flex:1}
input,select,textarea{font:inherit;color:inherit;background:var(--w);border:1px solid var(--bg2);border-radius:10px;padding:10px 12px;width:100%}
.bn{background:radial-gradient(500px 220px at 82% 10%,#c49a5042,transparent),linear-gradient(120deg,#1a130c,#3a2916 70%,#241a10);color:#f4eee3;padding:34px 0}.bn p{color:#cfc4b0;margin:0 0 14px}.bcr{font-size:.85rem;color:#b3a78f}.bcr a{text-decoration:none}main .bcr{color:var(--mg)}
.dh{display:grid;grid-template-columns:200px 1fr;gap:34px;align-items:center}.dh .cvr{box-shadow:0 18px 40px rgba(0,0,0,.5)}.dh h1{margin:10px 0 6px}.pp{display:flex;align-items:center;gap:14px;margin:14px 0}.pl{padding:8px 22px;border-radius:99px;font-weight:800}.pl.f{background:#2f9e6f;color:#fff}.pl.p{background:#d6b36a;color:#1a1405}.dh .btn.ghost{color:#f4eee3;border-color:#ffffff44}.dh .rt{font-size:.95rem}
.cg2{display:grid;grid-template-columns:240px minmax(0,1fr);gap:24px}.fs{background:var(--w);border:1px solid var(--bg2);border-radius:var(--r);padding:16px;align-self:start}.fs h3{font-size:1.05rem}.fs h4{margin:16px 0 8px}.cl{list-style:none;padding:0;margin:0;display:grid;gap:2px}.cl button{display:flex;gap:10px;align-items:center;width:100%;padding:8px 10px;border-radius:10px;background:none;border:0;color:inherit;font:inherit;font-size:.88rem;cursor:pointer;text-align:left}.cl button.on{background:var(--bg2);font-weight:700}.cl svg{width:18px;height:18px;color:var(--gd);flex:none}.cl b{margin-left:auto;color:var(--mg);font-weight:500;font-size:.8rem}.fd summary{cursor:pointer;font-weight:700;list-style:none}.rg label{display:flex;gap:8px;align-items:center;font-size:.88rem;padding:4px 0}.rg input{width:auto}
.tl{display:flex;gap:8px;margin-bottom:12px}.tl .ns{flex:1;width:auto;background:var(--w);border-color:var(--bg2)}.tl .ns input{color:inherit}.vt{display:flex;gap:4px}.vt button{width:40px;border:1px solid var(--bg2);border-radius:10px;background:var(--w);color:var(--mg);cursor:pointer}.vt button.on{background:var(--pri);color:var(--onpri)}
.pgn{display:flex;gap:6px;justify-content:center;margin-top:24px;flex-wrap:wrap}
.ft4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;background:var(--w);border:1px solid var(--bg2);border-radius:var(--r);padding:16px;margin-bottom:26px}.ft4 div{display:flex;gap:10px;align-items:center;font-size:.85rem}.ft4 svg{color:var(--gd);width:28px;height:28px;flex:none}.ft4 small{display:block;color:var(--mg)}
.dg2{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:26px}.tbs{display:flex;gap:22px;border-bottom:1px solid var(--bg2);margin-bottom:16px;overflow-x:auto}.tbs button{background:none;border:0;padding:12px 0;font:700 .92rem inherit;color:var(--mg);border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap}.tbs button.on{color:var(--ch);border-color:var(--gd)}
.dl{display:grid;gap:10px;font-size:.9rem}.dl div{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid var(--bg2);padding-bottom:8px}.dl span{color:var(--mg)}.desc{white-space:pre-wrap;max-width:64ch}
.msg{margin:8px 0;font-size:.9rem}.msg.err{color:#d9534f}.msg.ok{color:#2f9e6f}.state{text-align:center;padding:40px 18px;color:var(--mg);display:grid;gap:10px;justify-items:center;grid-column:1/-1}.state.err{color:#d9534f}
.sk{aspect-ratio:2/3;border-radius:18px;background:linear-gradient(90deg,var(--bg2),var(--w),var(--bg2));background-size:200% 100%;animation:sk 1.3s infinite}.sk.big{aspect-ratio:auto;height:280px}@keyframes sk{to{background-position:-200% 0}}
.auth{max-width:420px;margin:30px auto;background:var(--w);border:1px solid var(--bg2);border-radius:20px;padding:30px}.auth.wide{max-width:560px;margin:0}.auth label,.pn label{display:grid;gap:5px;font-weight:600;font-size:.9rem;margin-bottom:14px}.auth .btn{width:100%}
.kpi{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:24px}.kpi div{background:var(--w);border:1px solid var(--bg2);border-radius:var(--r);padding:18px;border-left:4px solid var(--gd)}.kpi b{display:block;font-size:1.8rem}.kpi span{color:var(--mg)}
.row{display:flex;gap:14px;align-items:center;justify-content:space-between;background:var(--w);border:1px solid var(--bg2);padding:16px;border-radius:var(--r)}.row>div{flex:1}.bar{height:6px;background:var(--bg2);border-radius:9px;margin:8px 0 4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--gd)}
.tw{overflow-x:auto;background:var(--w);border:1px solid var(--bg2);border-radius:var(--r)}table{width:100%;border-collapse:collapse;font-size:.88rem}th,td{text-align:left;padding:11px 12px;border-bottom:1px solid var(--bg2);white-space:nowrap}th{color:var(--mg)}
.tag{padding:2px 10px;border-radius:99px;font-size:.74rem;font-weight:700;background:var(--bg2)}.tag.paid,.tag.published{background:#1f6f4a;color:#d9f5e6}.tag.pending,.tag.draft{background:#7a5a12;color:#fdeccb}.tag.failed,.tag.refunded,.tag.archived{background:#8a2a2a;color:#fbdede}
.prose{white-space:pre-wrap;max-width:68ch}
.nlw{background:var(--bg2)}.nlr{display:flex;align-items:center;gap:16px;padding-top:16px;padding-bottom:16px;flex-wrap:wrap}.nlr>svg{color:var(--gd);width:34px;height:34px}.nlr small{display:block;color:var(--mg)}.nlr form{margin-left:auto;display:flex;gap:8px;flex:1;max-width:460px}.nlr form input{background:var(--w)}
footer{background:var(--hd);color:#a9aec8;padding:0 0 14px}footer a{color:#a9aec8;display:block;text-decoration:none;padding:3px 0;font-size:.9rem}footer a:hover{color:var(--gd)}footer .logo{color:#fff}footer h4{color:#fff;margin:0 0 8px}.fg{display:grid;grid-template-columns:1.6fr 1fr 1.2fr 1fr;gap:24px;padding-top:30px}.fg p{font-size:.88rem;max-width:34ch}.soc{display:flex;gap:10px;margin-top:8px}.soc a{width:34px;height:34px;border:1px solid #ffffff2a;border-radius:50%;display:grid;place-items:center;padding:0}.cp{text-align:center;margin:22px 0 0;font-size:.82rem;border-top:1px solid #ffffff14;padding-top:14px}
#toast{position:fixed;left:50%;bottom:24px;transform:translate(-50%,20px);background:#241d15;color:#f4eee3;padding:11px 20px;border-radius:99px;opacity:0;pointer-events:none;transition:.25s;z-index:99;border:1px solid var(--gd)}#toast.show{opacity:1;transform:translate(-50%,0)}#toast.err{background:#8a2a2a}
@media(max-width:900px){.hm,.cg2,.dg2{grid-template-columns:1fr}.ns{display:none}#mn .ns{display:flex;width:100%;margin:8px 0}.fg{grid-template-columns:1fr 1fr}}
@media(max-width:820px){.mt,.msr{display:grid}.ua{margin-left:auto}#mn{display:none;position:absolute;top:64px;left:0;right:0;background:var(--hd);flex-direction:column;align-items:stretch;padding:10px 16px 16px;border-bottom:1px solid #ffffff14;margin:0}#mn.open{display:flex}#mn a{padding:12px 6px}#mn a.on{box-shadow:none;color:var(--gd)}.nv{position:relative;gap:6px}.un{display:none}}
@media(max-width:640px){.grid{grid-template-columns:repeat(2,1fr);gap:12px}.grid.ls{grid-template-columns:1fr}.bc{padding:10px}.ac .ghost{display:none}.hero{padding:22px;min-height:290px}.dh{grid-template-columns:1fr;justify-items:center;text-align:center}.dh .cvr{width:170px}.dh .pp,.dh .ac{justify-content:center}.dh .rt{justify-content:center}.dh .chip{justify-self:center}.ft4{grid-template-columns:1fr 1fr}.shd h2{font-size:1.5rem}.cl{display:flex;overflow-x:auto;gap:6px}.cl button{width:auto;white-space:nowrap;border:1px solid var(--bg2)}.fg{grid-template-columns:1fr}.nlr form{max-width:none;width:100%}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}

.ad{display:grid;grid-template-columns:250px 1fr;min-height:100vh}
#side{background:#151413;border-right:1px solid var(--bg2);padding:18px 12px;display:flex;flex-direction:column;gap:3px;position:sticky;top:0;height:100vh;overflow-y:auto;color:#d8d2c6}#side .logo{padding:4px 8px 18px;color:#f1ece2}#side .logo b{letter-spacing:.06em;font-size:1.1rem}
#side a{display:flex;gap:12px;align-items:center;color:#a8a296;text-decoration:none;padding:11px 12px;border-radius:12px;font-size:.92rem;border:1px solid transparent}#side a:hover{background:#22201d;color:#fff}#side a.on{background:linear-gradient(90deg,#d1a95447,#d1a95414);border-color:#d1a95488;color:#fff;font-weight:700}#side a svg{width:19px;height:19px}#side a em,#bd{margin-left:auto;background:#d9534f;color:#fff;border-radius:99px;font-size:.68rem;font-style:normal;min-width:18px;height:18px;display:grid;place-items:center;padding:0 5px}#side .sp{flex:1}.lt{background:none;border:0;color:#a8a296;display:flex;gap:10px;align-items:center;padding:11px 12px;cursor:pointer;font:inherit}
.top{display:flex;align-items:center;gap:14px;padding:14px 26px;border-bottom:1px solid var(--bg2);position:sticky;top:0;z-index:10;background:var(--iv)}.gs{display:flex;align-items:center;gap:8px;background:var(--w);border:1px solid var(--bg2);border-radius:14px;padding:0 12px;flex:1;max-width:520px}.gs input{border:0;background:none;outline:0;padding:11px 0}.gs kbd{font-size:.7rem;color:var(--mg);border:1px solid var(--bg2);border-radius:6px;padding:2px 6px;white-space:nowrap}.top .sp{flex:1}
#bell{position:relative}#bd{position:absolute;top:2px;right:2px;margin:0}#bd:empty{display:none}.me{display:flex;gap:10px;align-items:center}.me .av{background:var(--gd);color:#1a1405;border:0}.me small{display:block;color:var(--mg);line-height:1}#amenu{display:none}#crumb{padding:12px 26px 0;color:var(--mg);font-size:.85rem}#crumb b{color:var(--ch)}
#main{padding:18px 26px 40px}.wl{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap;margin-bottom:18px}.wl h1{font-size:1.9rem;margin:0}.wl p{margin:4px 0 0}.wl select{width:auto}
.kk{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin-bottom:16px}
.kc{position:relative;overflow:hidden;border-radius:18px;padding:18px;display:flex;gap:14px;color:#2a2418;min-height:118px}.kc>svg{width:44px;height:44px;flex:none}.kc span{display:block;font-size:.88rem}.kc b{font-size:1.6rem;display:block;line-height:1.2}.kc em{font-style:normal;font-weight:700;font-size:.82rem}.kc em.up{color:#1f7a4a}.kc em.dn{color:#b23a3a}.sp{}
.kc .sp{position:absolute;right:0;bottom:0;width:55%;height:55%;color:#2a2418}.k1{background:linear-gradient(135deg,#efe3cb,#dcc592)}.k2{background:linear-gradient(135deg,#f0e6d3,#e3d2b0)}.k3{background:linear-gradient(135deg,#e3f1e5,#a9d4b5)}.k4{background:linear-gradient(135deg,#ebe6f7,#c9bdf0)}
.og{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:14px;margin-bottom:14px}.og2{display:grid;grid-template-columns:1.6fr 1fr;gap:14px}
.pn{background:var(--w);border:1px solid var(--bg2);border-radius:18px;padding:18px;margin-bottom:0}.pn h3{margin:0 0 10px;font-size:1.05rem}.pn p{margin:2px 0 10px}.cg{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:14px}
.ph2{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}.ph2 h3{margin:0}.ph2 select{width:auto;padding:6px 10px}.ph2 a{color:var(--gd);font-size:.8rem;text-decoration:none}
.kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:14px;margin-bottom:16px}.kp{background:var(--w);border:1px solid var(--bg2);border-radius:16px;padding:18px;display:grid;gap:2px}.kp svg{color:var(--gd)}.kp span,.kp small{color:var(--mg);font-size:.86rem}.kp b{font-size:1.5rem}
.tb{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}.tb input,.tb select{width:auto;min-width:150px}.tb label{display:flex;gap:8px;align-items:center}
.dnw{display:flex;gap:14px;align-items:center;flex-wrap:wrap}.dnw svg{width:130px;flex:none}.lg{list-style:none;padding:0;margin:0;flex:1;min-width:140px}.lg li{display:flex;gap:8px;align-items:center;font-size:.84rem;padding:2px 0}.lg li span{flex:1}.lg i{width:10px;height:10px;border-radius:50%}
.hb{display:grid;grid-template-columns:110px 1fr 30px;gap:8px;align-items:center;font-size:.88rem;margin:7px 0}.hb span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hb div{background:var(--bg2);border-radius:9px;height:10px}.hb i{display:block;height:100%;background:var(--gd);border-radius:9px}
.vb{width:100%}.hmp{display:grid;grid-template-columns:repeat(14,1fr);gap:4px}.hmp i{aspect-ratio:1;background:var(--gd);border-radius:4px}.fn{background:var(--gd);color:#1a1405;padding:9px 14px;border-radius:8px;margin:6px auto;display:flex;justify-content:space-between;font-size:.9rem}
.rkl{display:grid;grid-template-columns:22px 38px 1fr auto;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid var(--bg2);font-size:.86rem}.rkl:last-child{border:0}.rkl img,.th0{width:38px;height:50px;border-radius:4px;object-fit:cover;background:var(--bg2)}.rkl small{display:block;color:var(--mg)}.rkl>span{color:var(--mg);font-size:.78rem}
.tm{list-style:none;margin:0;padding:0;display:grid;gap:14px}.tm li{display:grid;grid-template-columns:34px 1fr;gap:10px;font-size:.86rem}.tm .ic{width:34px;height:34px;border-radius:50%;background:#d1a9541f;border:1px solid #d1a95466;color:var(--gd);display:grid;place-items:center}.tm .ic svg{width:16px;height:16px}.tm small{display:block;color:var(--mg)}
.tw{overflow-x:auto;background:var(--w);border:1px solid var(--bg2);border-radius:16px}
dialog{border:1px solid var(--bg2);background:var(--w);color:var(--ch);border-radius:20px;padding:26px;width:min(560px,94vw);max-height:92vh}dialog::backdrop{background:rgba(0,0,0,.6)}dialog label{display:grid;gap:5px;font-weight:600;font-size:.9rem;margin-bottom:12px}.r2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.ra{display:flex;gap:8px;justify-content:flex-end}
.deny{max-width:420px;margin:20vh auto;text-align:center;display:grid;gap:12px;justify-items:center}.hb2{padding:5px 0;font-size:.9rem}.hl{line-height:1.7}
@media(max-width:1100px){.og,.og2{grid-template-columns:1fr 1fr}.og .pn:first-child,.og2 .pn:first-child{grid-column:1/-1}}
@media(max-width:820px){.ad{grid-template-columns:1fr}#side{position:fixed;left:0;top:0;z-index:40;width:260px;transform:translateX(-100%);transition:.25s}#side.open{transform:none}#amenu{display:grid}#main,#crumb{padding-left:14px;padding-right:14px}.top{padding:10px 14px}.gs kbd,.me div{display:none}.og,.og2,.r2{grid-template-columns:1fr}.wl h1{font-size:1.5rem}}

body.rdr{--bg:#F5F2EC;--fg:#20211F;--pn:#fff;margin:0;background:var(--bg);color:var(--fg)}
body[data-th=sepia]{--bg:#f1e4c8;--fg:#4a3a22;--pn:#f8eed8}
body[data-th=dark]{--bg:#16171a;--fg:#d8d6cf;--pn:#222428}
body.rdr .rb{position:sticky;top:0;z-index:20;background:var(--pn);border-bottom:1px solid rgba(128,128,120,.25)}
body.rdr .rb .in{display:flex;align-items:center;gap:6px;padding:8px 14px;max-width:1100px;margin:auto}
body.rdr .rb b{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
body.rdr .rb button,body.rdr .rb a.ib{background:none;border:0;color:inherit;width:38px;height:38px;border-radius:50%;cursor:pointer;display:grid;place-items:center}
body.rdr .rb button:hover,body.rdr .rb a.ib:hover{background:rgba(128,128,120,.2)}
body.rdr #pbw{height:3px;background:rgba(128,128,120,.25)}
body.rdr #pb{height:100%;width:0;background:#B99A62}
body.rdr .pnl{position:fixed;top:60px;right:10px;width:min(340px,calc(100vw - 20px));max-height:calc(100vh - 80px);overflow:auto;background:var(--pn);color:var(--fg);border:1px solid rgba(128,128,120,.3);border-radius:14px;padding:14px;z-index:25;box-shadow:0 14px 40px rgba(0,0,0,.2)}
body.rdr .pnl[hidden]{display:none}
body.rdr .pnl label{display:grid;gap:4px;font-size:.85rem;margin-bottom:10px}
body.rdr .pnl input,body.rdr .pnl select{background:var(--bg);color:var(--fg);border:1px solid rgba(128,128,120,.4);border-radius:8px;padding:7px;width:100%}
body.rdr #toc a,body.rdr #sr button,body.rdr .bmk button:first-child{display:block;padding:7px 8px;color:inherit;text-decoration:none;border-radius:8px;background:none;border:0;text-align:left;font:inherit;cursor:pointer;width:100%}
body.rdr #toc a:hover,body.rdr #sr button:hover{background:rgba(128,128,120,.18)}
body.rdr #toc .l2{padding-left:20px}
body.rdr #toc .l3{padding-left:34px}
body.rdr .bmk{display:flex}
body.rdr .bmk button:last-child{background:none;border:0;color:inherit;cursor:pointer}
body.rdr .th{display:flex;gap:6px}
body.rdr .th button{flex:1;padding:8px;border-radius:8px;border:1px solid rgba(128,128,120,.4);background:var(--bg);color:var(--fg);cursor:pointer}
body.rdr #doc{margin:0 auto;padding:40px 18px 140px}
body.rdr #doc h1,body.rdr #doc h2,body.rdr #doc h3{line-height:1.25;margin:1.6em 0 .6em}
body.rdr #doc p{margin:0 0 1.1em}
body.rdr #doc img{max-width:100%;height:auto}
body.rdr #doc .hit,body.rdr .hit{background:#B99A62;color:#20211F}
body.rdr .nav2{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);display:flex;gap:8px;z-index:15}
body.rdr .nav2 button{background:var(--pn);color:var(--fg);border:1px solid rgba(128,128,120,.4);border-radius:99px;padding:10px 16px;cursor:pointer;font:inherit}
body.rdr .state{max-width:420px;margin:20vh auto;text-align:center;display:grid;gap:12px;justify-items:center}
body.rdr .btn{display:inline-block;background:#20211F;color:#F5F2EC;padding:9px 18px;border-radius:99px;text-decoration:none}
body.rdr .btn.ghost{background:none;color:inherit;border:1px solid rgba(128,128,120,.5)}
body.rdr .mut{opacity:.65}</style></head><body><div id="root"></div><noscript>Aktifkan JavaScript untuk memakai NEXT BETTER.</noscript>
<script src="https://cdn.jsdelivr.net/npm/lucide@0.453.0/dist/umd/lucide.min.js"></script>
<script type="module">
import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/+esm';
const RECOVERY = /type=recovery/.test(window.location.hash); // harus dibaca sebelum Supabase membersihkan hash
/* ============ KONFIGURASI SUPABASE (publishable key aman di frontend; JANGAN pakai service_role) ============ */
// Konfigurasi Supabase. Publishable key aman dipublikasikan (dilindungi RLS).
// JANGAN pernah menaruh service_role key di sini.
const SUPABASE_URL = 'https://tgnvlniimkmbcjagjvbo.supabase.co';
const SUPABASE_KEY = 'sb_publishable_IBQyLZdk0aTCTSNbVLeqUw_PFtljozZ';
const sb = createClient(SUPABASE_URL, SUPABASE_KEY);
const $ = (s, r = document) => r.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const rp = n => 'Rp' + Number(n || 0).toLocaleString('id-ID');
const icons = () => window.lucide && window.lucide.createIcons();
function toast(m, err) {
  let t = $('#toast'); if (!t) { t = document.createElement('div'); t.id = 'toast'; t.setAttribute('role', 'status'); document.body.append(t); }
  t.textContent = m; t.className = 'show' + (err ? ' err' : ''); clearTimeout(toast.t); toast.t = setTimeout(() => t.className = '', 3200);
}
async function me() { const { data: { session } } = await sb.auth.getSession(); return session?.user || null; }
async function isAdmin(u) {
  if (!u) return false;
  const { data } = await sb.from('admin_users').select('user_id').eq('user_id', u.id).maybeSingle();
  return !!data;
}
const safeNext = n => /^[a-z0-9_-]+\.html(\?[\w=&%.-]*)?$/i.test(n || '') ? n : 'dashboard.html';
async function layout() {
  const u = await me(), adm = await isAdmin(u); let name = '';
  if (u) { const { data } = await sb.from('profiles').select('full_name').eq('id', u.id).maybeSingle(); name = data?.full_name || u.email; }
  const { data: st } = await sb.from('website_settings').select('key,value');
  const S = Object.fromEntries((st || []).map(r => [r.key, r.value]));
  const { data: cs } = await sb.from('categories').select('name,slug').order('sort_order').limit(6);
  const cur = ROUTE.file + ROUTE.search;
  const L = [['index.html', 'Beranda'], ['catalog.html', 'Ebook'], ['index.html#kategori', 'Kategori'], ['catalog.html?type=premium', 'Premium'], ['info.html?p=about', 'Tentang']];
  $('#nav').innerHTML = `<div class="wrap nv"><a class="logo" href="index.html"><i data-lucide="book-open"></i><span><b>GALLERY</b><small>NEXT BETTER</small></span></a>
  <nav id="mn">${L.map(l => `<a href="${l[0]}" class="${l[0] == cur ? 'on' : ''}">${l[1]}</a>`).join('')}<form class="ns" action="catalog.html"><input name="q" placeholder="Cari judul, penulis, atau kategori..." aria-label="Cari ebook"><button class="ib" aria-label="Cari"><i data-lucide="search"></i></button></form></nav>
  <div class="ua"><form class="ns" action="catalog.html"><input name="q" placeholder="Cari judul, penulis, atau kategori..." aria-label="Cari ebook"><button class="ib" aria-label="Cari"><i data-lucide="search"></i></button></form>
  ${u ? `<details class="um"><summary><span class="av">${esc(name[0] || 'U').toUpperCase()}</span><span class="un">${esc(name)}</span></summary><div class="dd"><a href="profile.html">Profil</a><a href="my-books.html">Ebook saya</a><a href="dashboard.html">Riwayat pembelian</a><a href="profile.html#pengaturan">Pengaturan akun</a>${adm ? '<a href="admin.html">Dashboard admin</a>' : ''}<button id="lo">Logout</button></div></details>` : `<a class="btn ghost sm" href="login.html">Masuk</a>`}
  <a class="ib msr" href="catalog.html#cari" aria-label="Cari"><i data-lucide="search"></i></a><button class="ib mt" id="mt" aria-label="Buka menu"><i data-lucide="menu"></i></button></div></div>`;
  $('#mt').onclick = () => $('#mn').classList.toggle('open');
  $('#lo') && ($('#lo').onclick = async () => { await sb.auth.signOut(); window.location.hash = '#/index'; window.location.reload(); });
  const soc = [['instagram', 'instagram'], ['youtube', 'youtube'], ['x', 'twitter']].filter(k => /^https:\/\//.test(S[k[0]] || '')).map(k => `<a href="${esc(S[k[0]])}" rel="noopener" target="_blank" aria-label="${k[0]}"><i data-lucide="${k[1]}"></i></a>`).join('');
  $('#ft').innerHTML = `<div class="nlw"><div class="wrap nlr"><i data-lucide="mail"></i><div><b>Berlangganan Newsletter</b><small>Dapatkan rekomendasi ebook terbaru langsung ke email Anda.</small></div><form id="nl" novalidate><input name="email" type="email" placeholder="Masukkan email Anda" aria-label="Email" required><button class="btn rd">Berlangganan</button></form><div id="nlm" class="msg" role="status" style="width:100%;margin:0"></div></div></div>
  <div class="wrap fg"><div><a class="logo" href="index.html"><i data-lucide="book-open"></i><span><b>NEXT BETTER</b><small>READ. LEARN. GROW.</small></span></a><p>${esc(S.tagline || 'Ruang digital untuk pengetahuan, inspirasi, dan pertumbuhan.')}</p></div>
  <div><h4>Navigasi</h4><a href="index.html">Beranda</a><a href="catalog.html">Jelajahi Ebook</a><a href="catalog.html?type=premium">Premium</a><a href="info.html?p=about">Tentang Kami</a></div>
  <div><h4>Kategori</h4>${(cs || []).map(c => `<a href="catalog.html?cat=${esc(c.slug)}">${esc(c.name)}</a>`).join('') || '<a href="catalog.html">Semua ebook</a>'}</div>
  <div><h4>Kontak</h4><a href="info.html?p=contact">${esc(S.contact || 'Hubungi kami')}</a><a href="info.html?p=privacy_policy">Kebijakan Privasi</a><a href="info.html?p=terms">Syarat dan Ketentuan</a><div class="soc">${soc}</div></div></div><p class="cp">© ${new Date().getFullYear()} NEXT BETTER. Semua hak dilindungi. · READ. LEARN. GROW.</p>`;
  $('#nl').onsubmit = async e => {
    e.preventDefault(); const em = new FormData(e.target).get('email').trim(), m = $('#nlm');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)) { m.textContent = 'Format email tidak valid.'; m.className = 'msg err'; return; }
    const { error } = await sb.from('newsletter_subscribers').insert({ email: em });
    m.className = 'msg ' + (error && error.code !== '23505' ? 'err' : 'ok');
    m.textContent = !error ? 'Terima kasih, kamu sudah berlangganan.' : error.code === '23505' ? 'Email ini sudah berlangganan.' : 'Gagal berlangganan: ' + error.message;
  };
  icons(); return { u, adm, S };
}

const __loc = { get search() { return ROUTE.search; }, get hash() { return ROUTE.anchor ? '#' + ROUTE.anchor : ''; }, get origin() { return window.location.origin; }, get pathname() { return window.location.pathname; }, get href() { return window.location.href; }, set href(v) { nav(v); }, replace(v) { nav(v); }, reload() { window.location.reload(); } };
async function P_books() {
const location = __loc;
await layout();
const pg = ROUTE.page, P = new URLSearchParams(location.search), app = $('#app');
const skel = n => Array(n).fill('<div class="sk"></div>').join('');
const state = (t, ic = 'info') => `<div class="state"><i data-lucide="${ic}"></i><p>${esc(t)}</p></div>`;
const fail = e => `<div class="state err"><i data-lucide="triangle-alert"></i><p>Gagal memuat data: ${esc(e.message || e)}</p><button class="btn sm" onclick="location.reload()">Coba lagi</button></div>`;
const loadCats = async () => { const { data, error } = await sb.from('categories').select('*').order('sort_order'); if (error) throw error; return data || []; };
const loadBooks = async () => { const { data, error } = await sb.from('books').select('*,categories(name,slug,icon)').eq('status', 'published').order('created_at', { ascending: false }); if (error) throw error; return data || []; };
const sorter = s => (a, b) => s == 'pop' ? (b.read_count || 0) - (a.read_count || 0) : s == 'az' ? a.title.localeCompare(b.title) : s == 'plow' ? (a.is_premium ? a.price : 0) - (b.is_premium ? b.price : 0) : s == 'phigh' ? (b.is_premium ? b.price : 0) - (a.is_premium ? a.price : 0) : 0;
const rate = b => b.rating_avg > 0 ? `<div class="rt"><i data-lucide="star"></i><b>${Number(b.rating_avg).toFixed(1)}</b>${b.rating_count ? `<small>(${b.rating_count})</small>` : ''}</div>` : '';
const cover = b => b.cover_url ? `<img src="${esc(b.cover_url)}" alt="Cover ${esc(b.title)}" loading="lazy">` : `<div class="nc"><i data-lucide="${esc(b.categories?.icon || 'book-open')}"></i><span>${esc(b.title)}</span></div>`;
const card = b => `<article class="bc"><a class="cvr" href="book.html?id=${b.id}" aria-label="${esc(b.title)}">${cover(b)}<span class="tg ${b.is_premium ? 'p' : 'f'}">${b.is_premium ? 'Premium' : 'Gratis'}</span></a><div class="bi"><small class="au">${esc(b.author || '')}</small><h3><a href="book.html?id=${b.id}">${esc(b.title)}</a></h3>${b.categories ? `<span class="chip">${esc(b.categories.name)}</span>` : ''}${rate(b)}${b.is_premium ? `<div class="pr">${rp(b.price)}</div>` : ''}<div class="ac"><a class="btn ghost sm" href="book.html?id=${b.id}">Detail</a><a class="btn sm ${b.is_premium ? '' : 'rd'}" href="${b.is_premium ? 'book.html?id=' + b.id + '#beli' : 'reader.html?id=' + b.id}">${b.is_premium ? 'Beli Sekarang' : 'Baca Sekarang'}</a></div></div></article>`;
const banner = (t, p, crumb) => `<div class="bn"><div class="wrap"><h1>${t}</h1><p>${p}</p><nav class="bcr" aria-label="Breadcrumb"><a href="index.html">Beranda</a> › ${crumb}</nav></div></div>`;

async function home() {
  $('#feat').innerHTML = skel(4);
  let cats, books; try { [cats, books] = await Promise.all([loadCats(), loadBooks()]); } catch (e) { $('#feat').innerHTML = fail(e); return icons(); }
  const H = { cat: '', sort: 'new' };
  $('#ct').innerHTML = `<button class="ctab on" data-c=""><i data-lucide="layout-grid"></i>Semua</button>` + cats.map(c => `<button class="ctab" data-c="${c.id}"><i data-lucide="${esc(c.icon)}"></i>${esc(c.name)}</button>`).join('');
  const draw = () => {
    const l = books.filter(b => !H.cat || b.category_id == H.cat).sort(sorter(H.sort));
    $('#tot').textContent = 'Total ' + l.length + ' buku';
    $('#feat').innerHTML = l.slice(0, 10).map(card).join('') || state('Belum ada ebook pada kategori ini.', 'book-open');
    icons();
  };
  $('#ct').onclick = e => { const b = e.target.closest('.ctab'); if (!b) return; H.cat = b.dataset.c; document.querySelectorAll('.ctab').forEach(x => x.classList.toggle('on', x == b)); draw(); };
  $('#so').onchange = e => { H.sort = e.target.value; draw(); };
  const pop = books.filter(b => b.read_count > 0).sort(sorter('pop')).slice(0, 5);
  $('#pl').innerHTML = pop.map((b, i) => `<a class="pi" href="book.html?id=${b.id}" style="text-decoration:none"><span class="rk">${i + 1}</span><span class="cvr">${cover(b)}</span><div><b>${esc(b.title)}</b><small>${esc(b.author || '')}</small><div class="rt">${b.rating_avg > 0 ? '<i data-lucide="star"></i><b>' + Number(b.rating_avg).toFixed(1) + '</b>' : ''}${i < 3 ? '<span class="bst">Terpopuler</span>' : ''}</div></div></a>`).join('') || '<p class="mut">Belum ada data bacaan.</p>';
  draw();
}

async function catalog() {
  $('#bn').innerHTML = banner('Katalog E-Book', 'Temukan buku terbaik untuk perjalanan belajarmu.', 'Katalog');
  app.innerHTML = `<div class="grid">${skel(8)}</div>`;
  let cats, books; try { [cats, books] = await Promise.all([loadCats(), loadBooks()]); } catch (e) { app.innerHTML = fail(e); return icons(); }
  const F = { q: P.get('q') || '', cat: P.get('cat') || '', pf: P.get('type') == 'free' || P.get('type') == 'premium' ? P.get('type') : '', sort: ['pop', 'az', 'plow', 'phigh'].includes(P.get('sort')) ? P.get('sort') : 'new', page: 1, view: 'g' }, N = 12;
  const R = { r1: [0, 50000], r2: [50000, 100000], r3: [100000, 1e12] }, cnt = c => books.filter(b => !c || b.categories?.slug == c).length;
  app.innerHTML = `<div class="cg2"><aside class="fs"><h3>Kategori</h3><ul class="cl" id="cl"><li><button data-c="" class="${F.cat ? '' : 'on'}"><i data-lucide="layout-grid"></i>Semua Kategori<b>${books.length}</b></button></li>${cats.map(c => `<li><button data-c="${esc(c.slug)}" class="${c.slug == F.cat ? 'on' : ''}"><i data-lucide="${esc(c.icon)}"></i>${esc(c.name)}<b>${cnt(c.slug)}</b></button></li>`).join('')}</ul>
  <details class="fd" id="fd" open><summary><h4>Filter Harga & Urutan</h4></summary><div class="rg" id="rg">${[['', 'Semua'], ['free', 'Gratis (' + books.filter(b => !b.is_premium).length + ')'], ['premium', 'Premium (' + books.filter(b => b.is_premium).length + ')'], ['r1', 'Rp0 – Rp50.000'], ['r2', 'Rp50.000 – Rp100.000'], ['r3', '> Rp100.000']].map(r => `<label><input type="radio" name="pf" value="${r[0]}" ${r[0] == F.pf ? 'checked' : ''}>${r[1]}</label>`).join('')}</div>
  <h4>Urutkan</h4><select id="so" aria-label="Urutkan"><option value="new">Terbaru</option><option value="pop">Terpopuler</option><option value="az">A–Z</option><option value="plow">Harga terendah</option><option value="phigh">Harga tertinggi</option></select></details></aside>
  <section><div class="tl"><form class="ns" id="sf"><input id="sq" type="search" placeholder="Cari judul atau penulis..." aria-label="Cari" value="${esc(F.q)}"><button class="ib" aria-label="Cari"><i data-lucide="search"></i></button></form><div class="vt"><button class="on" data-v="g" aria-label="Tampilan grid"><i data-lucide="layout-grid"></i></button><button data-v="l" aria-label="Tampilan daftar"><i data-lucide="list"></i></button></div></div><p id="cnt" class="mut"></p><div id="g" class="grid"></div><div id="pgn" class="pgn"></div></section></div>`;
  if (innerWidth < 820) $('#fd').open = false; $('#so').value = F.sort; if (location.hash == '#cari') $('#sq').focus();
  const draw = () => {
    const l = books.filter(b => (!F.q || (b.title + ' ' + (b.author || '') + ' ' + (b.categories?.name || '')).toLowerCase().includes(F.q.toLowerCase())) && (!F.cat || b.categories?.slug == F.cat) && (F.pf == '' || (F.pf == 'free' ? !b.is_premium : F.pf == 'premium' ? b.is_premium : b.is_premium && b.price >= R[F.pf][0] && b.price <= R[F.pf][1]))).sort(sorter(F.sort));
    const pages = Math.max(1, Math.ceil(l.length / N)); F.page = Math.min(F.page, pages);
    $('#cnt').textContent = l.length ? `Menampilkan ${(F.page - 1) * N + 1}–${Math.min(F.page * N, l.length)} dari ${l.length} ebook` : '';
    $('#g').className = 'grid' + (F.view == 'l' ? ' ls' : '');
    $('#g').innerHTML = l.slice((F.page - 1) * N, F.page * N).map(card).join('') || state('Tidak ada ebook yang cocok. Ubah kata kunci atau filter.', 'search-x');
    $('#pgn').innerHTML = pages > 1 ? Array.from({ length: pages }, (_, i) => `<button class="btn sm ${i + 1 == F.page ? '' : 'ghost'}" data-p="${i + 1}" aria-label="Halaman ${i + 1}">${i + 1}</button>`).join('') : '';
    icons();
  };
  $('#cl').onclick = e => { const b = e.target.closest('button'); if (!b) return; F.cat = b.dataset.c; F.page = 1; document.querySelectorAll('#cl button').forEach(x => x.classList.toggle('on', x == b)); draw(); };
  $('#rg').onchange = e => { F.pf = e.target.value; F.page = 1; draw(); };
  $('#so').onchange = e => { F.sort = e.target.value; F.page = 1; draw(); };
  $('#sq').oninput = e => { F.q = e.target.value; F.page = 1; draw(); }; $('#sf').onsubmit = e => e.preventDefault();
  document.querySelector('.vt').onclick = e => { const b = e.target.closest('button'); if (!b) return; F.view = b.dataset.v; document.querySelectorAll('.vt button').forEach(x => x.classList.toggle('on', x == b)); draw(); };
  $('#pgn').onclick = e => { const p = e.target.dataset.p; if (p) { F.page = +p; draw(); scrollTo({ top: 0 }); } };
  draw();
}

async function detail() {
  const id = P.get('id');
  const { data: b, error } = await sb.from('books').select('*,categories(name,slug,icon)').eq('id', id || '').eq('status', 'published').maybeSingle();
  if (error || !b) { app.innerHTML = state('Ebook tidak ditemukan.', 'book-x') + '<p class="ctr"><a class="btn" href="catalog.html">Kembali ke katalog</a></p>'; return icons(); }
  const u = await me(); let owned = !b.is_premium, pending = null;
  if (u && b.is_premium) { const { data } = await sb.from('purchases').select('id,status').eq('user_id', u.id).eq('book_id', b.id); owned = (data || []).some(p => p.status == 'paid'); pending = (data || []).find(p => p.status == 'pending'); }
  const { data: rel } = await sb.from('books').select('*,categories(name,slug,icon)').eq('status', 'published').eq('category_id', b.category_id).neq('id', b.id).limit(4);
  document.title = b.title + ' – NEXT BETTER';
  $('#bn').innerHTML = `<div class="bn"><div class="wrap dh"><div class="cvr">${cover(b)}</div><div><nav class="bcr" aria-label="Breadcrumb"><a href="index.html">Beranda</a> › <a href="catalog.html">Katalog</a> › ${esc(b.title)}</nav><h1>${esc(b.title)}</h1><p style="margin:0 0 8px">${esc(b.author || '-')}</p>${rate(b)}${b.categories ? `<span class="chip" style="margin-top:8px">${esc(b.categories.name)}</span>` : ''}
  <div class="pp"><span class="pl ${b.is_premium ? 'p' : 'f'}">${b.is_premium ? rp(b.price) : 'Gratis'}</span></div>
  <div class="ac" id="beli">${owned ? `<a class="btn rd" href="reader.html?id=${b.id}"><i data-lucide="book-open"></i>Baca Sekarang</a>` : `<button class="btn rd" id="buy"><i data-lucide="shopping-cart"></i>${pending ? 'Menunggu pembayaran' : 'Beli Ebook'}</button>`}<button class="btn ghost" id="sh"><i data-lucide="share-2"></i>Bagikan</button></div><div id="bm" class="msg"></div></div></div></div>`;
  const info = [['Penulis', b.author || '-'], ['Kategori', b.categories?.name || '-'], ['Tipe', 'Ebook HTML'], ['Akses', b.is_premium ? 'Premium (berbayar)' : 'Gratis'], ['Diterbitkan', new Date(b.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })]];
  app.innerHTML = `<div class="ft4"><div><i data-lucide="zap"></i><span><b>Akses Instan</b><small>Baca langsung</small></span></div><div><i data-lucide="monitor-smartphone"></i><span><b>Multi-Perangkat</b><small>Desktop & Mobile</small></span></div><div><i data-lucide="bookmark"></i><span><b>Bookmark</b><small>Simpan halaman</small></span></div><div><i data-lucide="circle-play"></i><span><b>Progress</b><small>Lanjutkan membaca</small></span></div></div>
  <div class="dg2"><div><div class="tbs" role="tablist"><button class="on" data-t="t1">Deskripsi</button><button data-t="t2">Informasi Buku</button><button data-t="t3">Rekomendasi</button></div>
  <div id="t1"><h2>Tentang Buku</h2><p class="desc">${esc(b.description || 'Belum ada deskripsi.')}</p></div>
  <div id="t2" hidden><div class="dl">${info.map(i => `<div><span>${i[0]}</span><b>${esc(i[1])}</b></div>`).join('')}</div></div>
  <div id="t3" hidden><div class="grid">${(rel || []).map(card).join('') || state('Belum ada ebook serupa.')}</div></div></div>
  <aside class="card"><h3>Detail Buku</h3><div class="dl">${info.slice(0, 4).map(i => `<div><span>${i[0]}</span><b>${esc(i[1])}</b></div>`).join('')}</div></aside></div>`;
  icons();
  document.querySelector('.tbs').onclick = e => { const t = e.target.dataset.t; if (!t) return; document.querySelectorAll('.tbs button').forEach(x => x.classList.toggle('on', x.dataset.t == t)); ['t1', 't2', 't3'].forEach(x => $('#' + x).hidden = x != t); };
  $('#sh').onclick = async () => { try { if (navigator.share) await navigator.share({ title: b.title, url: location.href }); else { await navigator.clipboard.writeText(location.href); toast('Tautan disalin'); } } catch (e) { } };
  const bt = $('#buy'); if (bt) bt.onclick = async () => {
    if (!u) return location.href = 'login.html?next=' + encodeURIComponent('book.html?id=' + b.id);
    const m = $('#bm');
    if (pending) { m.className = 'msg ok'; m.textContent = 'Transaksi ' + pending.id + ' berstatus pending. Akses dibuka setelah pembayaran terverifikasi.'; return; }
    const { data, error } = await sb.from('purchases').insert({ user_id: u.id, book_id: b.id, amount: b.price, status: 'pending' }).select('id').single();
    m.className = 'msg ' + (error ? 'err' : 'ok');
    m.textContent = error ? 'Gagal membuat transaksi: ' + error.message : 'Transaksi pending dibuat (' + data.id + '). Akses terbuka setelah backend memverifikasi pembayaran (status paid).';
    if (!error) { pending = data; bt.lastChild.textContent = 'Menunggu pembayaran'; }
  };
}

async function info() {
  const k = ['about', 'contact', 'privacy_policy', 'terms'].includes(P.get('p')) ? P.get('p') : 'about';
  const T = { about: 'Tentang Kami', contact: 'Kontak', privacy_policy: 'Kebijakan Privasi', terms: 'Syarat dan Ketentuan' };
  const { data } = await sb.from('website_settings').select('value').eq('key', k).maybeSingle();
  app.innerHTML = `<h1>${T[k]}</h1><div class="prose">${data?.value ? esc(data.value) : 'Konten ini belum diisi. Admin dapat mengisinya di Dashboard Admin › Pengaturan Website.'}</div>`;
}
({ index: home, catalog, book: detail, info })[pg]?.();

}
async function P_auth() {
const location = __loc;
await layout();
const pg = ROUTE.page, next = safeNext(new URLSearchParams(location.search).get('next'));
const box = h => { $('#app').innerHTML = `<div class="auth">${h}</div>`; };
const msg = (t, ok) => { const e = $('#msg'); e.textContent = t; e.className = 'msg ' + (ok ? 'ok' : 'err'); };
const okEmail = e => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(e);
const busy = (b, v) => { b.disabled = v; b.textContent = v ? 'Memproses...' : b.dataset.t; };

function loginForm() {
  box(`<h1>Masuk</h1><p class="mut">Lanjutkan membaca koleksimu.</p><form id="f" novalidate><label>Email<input name="email" type="email" autocomplete="email" required></label><label>Password<input name="pw" type="password" autocomplete="current-password" required></label><div id="msg" role="alert"></div><button class="btn" data-t="Masuk">Masuk</button></form><p><a href="#" id="fg">Lupa password?</a> · <a href="register.html">Belum punya akun?</a></p>`);
  $('#fg').onclick = e => { e.preventDefault(); forgot(); };
  $('#f').onsubmit = async e => {
    e.preventDefault(); const f = new FormData(e.target), b = $('#f button'); b.dataset.t = 'Masuk';
    if (!okEmail(f.get('email'))) return msg('Format email tidak valid.');
    busy(b, true); const { error } = await sb.auth.signInWithPassword({ email: f.get('email'), password: f.get('pw') }); busy(b, false);
    if (error) return msg(error.message.includes('Email not confirmed') ? 'Email belum diverifikasi. Cek kotak masukmu.' : 'Email atau password salah.');
    location.href = next;
  };
}
function forgot() {
  box(`<h1>Lupa password</h1><p class="mut">Kami kirim tautan reset ke emailmu.</p><form id="f" novalidate><label>Email<input name="email" type="email" required></label><div id="msg" role="alert"></div><button class="btn" data-t="Kirim tautan reset">Kirim tautan reset</button></form><p><a href="login.html">Kembali ke login</a></p>`);
  $('#f').onsubmit = async e => {
    e.preventDefault(); const em = new FormData(e.target).get('email'), b = $('#f button'); b.dataset.t = 'Kirim tautan reset';
    if (!okEmail(em)) return msg('Format email tidak valid.');
    busy(b, true); const { error } = await sb.auth.resetPasswordForEmail(em, { redirectTo: location.origin + location.pathname }); busy(b, false);
    error ? msg(error.message) : msg('Jika email terdaftar, tautan reset sudah dikirim.', 1);
  };
}
function reset() {
  box(`<h1>Password baru</h1><form id="f" novalidate><label>Password baru<input name="pw" type="password" minlength="8" required></label><label>Konfirmasi<input name="pw2" type="password" required></label><div id="msg" role="alert"></div><button class="btn" data-t="Simpan password">Simpan password</button></form>`);
  $('#f').onsubmit = async e => {
    e.preventDefault(); const f = new FormData(e.target), b = $('#f button'); b.dataset.t = 'Simpan password';
    if (f.get('pw').length < 8) return msg('Password minimal 8 karakter.');
    if (f.get('pw') !== f.get('pw2')) return msg('Konfirmasi password tidak cocok.');
    busy(b, true); const { error } = await sb.auth.updateUser({ password: f.get('pw') }); busy(b, false);
    if (error) return msg(error.message); msg('Password diperbarui. Mengalihkan...', 1); setTimeout(() => location.href = 'dashboard.html', 1200);
  };
}
function register() {
  box(`<h1>Buat akun</h1><p class="mut">Gratis. Verifikasi lewat email.</p><form id="f" novalidate><label>Nama lengkap<input name="name" autocomplete="name" required></label><label>Email<input name="email" type="email" required></label><label>Password<input name="pw" type="password" minlength="8" autocomplete="new-password" required></label><label>Konfirmasi password<input name="pw2" type="password" required></label><div id="msg" role="alert"></div><button class="btn" data-t="Daftar">Daftar</button></form><p><a href="login.html">Sudah punya akun?</a></p>`);
  $('#f').onsubmit = async e => {
    e.preventDefault(); const f = new FormData(e.target), b = $('#f button'); b.dataset.t = 'Daftar';
    if (f.get('name').trim().length < 2) return msg('Nama lengkap wajib diisi.');
    if (!okEmail(f.get('email'))) return msg('Format email tidak valid.');
    if (f.get('pw').length < 8) return msg('Password minimal 8 karakter.');
    if (f.get('pw') !== f.get('pw2')) return msg('Konfirmasi password tidak cocok.');
    busy(b, true);
    const { data, error } = await sb.auth.signUp({ email: f.get('email'), password: f.get('pw'), options: { data: { full_name: f.get('name').trim() }, emailRedirectTo: location.origin + location.pathname.replace('register.html', 'login.html') } });
    busy(b, false); if (error) return msg(error.message);
    data.session ? location.href = 'dashboard.html' : msg('Akun dibuat. Cek email untuk verifikasi, lalu login.', 1);
  };
}
sb.auth.onAuthStateChange(ev => { if (ev === 'PASSWORD_RECOVERY') reset(); });
pg === 'register' ? register() : (ROUTE.recovery ? reset() : loginForm());

}
async function P_dashboard() {
const location = __loc;
await layout();
const pg = ROUTE.page, app = $('#app'), u = await me();
if (!u) location.replace('login.html?next=' + pg + '.html');
const fmt = d => d ? new Date(d).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
const q = async p => { const { data, error } = await p; if (error) throw error; return data || []; };
const booksBy = async ids => ids.length ? q(sb.from('books').select('id,title,author,cover_url,is_premium,price').in('id', ids)) : [];
const empty = (t, a) => `<div class="state"><i data-lucide="book-open"></i><p>${t}</p>${a || ''}</div>`;
async function data() {
  const [pur, prog] = await Promise.all([q(sb.from('purchases').select('*').eq('user_id', u.id).order('created_at', { ascending: false })), q(sb.from('reading_progress').select('*').eq('user_id', u.id).order('updated_at', { ascending: false }))]);
  const bk = await booksBy([...new Set([...pur.map(p => p.book_id), ...prog.map(p => p.book_id)])]);
  return { pur, prog, bk, by: id => bk.find(b => b.id == id) };
}
async function main() {
  try {
    const D = await data();
    if (pg == 'dashboard') {
      const paid = D.pur.filter(p => p.status == 'paid'), last = D.prog[0], lb = last && D.by(last.book_id);
      app.innerHTML = `<h1>Dashboard</h1><div class="kpi"><div><b>${paid.length}</b><span>Ebook dibeli</span></div><div><b>${D.prog.filter(p => p.completed).length}</b><span>Selesai dibaca</span></div><div><b>${D.prog.length}</b><span>Ebook dibaca</span></div></div>
      <h2>Terakhir dibaca</h2>${lb ? `<div class="row"><div><b>${esc(lb.title)}</b><div class="bar"><i style="width:${Math.round(last.position * 100)}%"></i></div><small>${Math.round(last.position * 100)}% · ${fmt(last.updated_at)}</small></div><a class="btn sm" href="reader.html?id=${lb.id}">Lanjutkan</a></div>` : empty('Belum ada aktivitas membaca.', '<a class="btn sm" href="catalog.html">Cari ebook</a>')}
      <h2>Riwayat pembelian</h2>${D.pur.length ? `<div class="tw"><table><tr><th>No. transaksi</th><th>Ebook</th><th>Tanggal</th><th>Harga</th><th>Status</th></tr>${D.pur.map(p => `<tr><td><small>${esc(p.id)}</small></td><td>${esc(D.by(p.book_id)?.title || '-')}</td><td>${fmt(p.created_at)}</td><td>${rp(p.amount)}</td><td><span class="tag ${p.status}">${esc(p.status)}</span></td></tr>`).join('')}</table></div>` : empty('Belum ada pembelian.')}`;
    }
    if (pg == 'my-books') {
      const ids = new Set([...D.pur.filter(p => p.status == 'paid').map(p => p.book_id), ...D.prog.map(p => p.book_id)]);
      const list = D.bk.filter(b => ids.has(b.id));
      app.innerHTML = `<h1>Ebook saya</h1>${list.length ? `<div class="grid">${list.map(b => { const p = D.prog.find(x => x.book_id == b.id), pc = Math.round((p?.position || 0) * 100); return `<article class="bc"><a class="cvr" href="reader.html?id=${b.id}">${b.cover_url ? `<img src="${esc(b.cover_url)}" alt="Cover ${esc(b.title)}">` : `<div class="nc"><i data-lucide="book-open"></i><b>${esc(b.title)}</b></div>`}</a><div class="bi"><h3>${esc(b.title)}</h3><div class="bar"><i style="width:${pc}%"></i></div><small>${pc}% dibaca</small><a class="btn sm" href="reader.html?id=${b.id}">${pc ? 'Lanjutkan membaca' : 'Mulai membaca'}</a></div></article>`; }).join('')}</div>` : empty('Koleksimu masih kosong.', '<a class="btn sm" href="catalog.html">Jelajahi ebook</a>')}`;
    }
    if (pg == 'profile') {
      const { data: p } = await sb.from('profiles').select('*').eq('id', u.id).maybeSingle();
      app.innerHTML = `<h1>Profil</h1><div class="auth wide"><form id="pf"><label>Nama lengkap<input name="n" value="${esc(p?.full_name || '')}" required></label><label>Email<input value="${esc(u.email)}" disabled></label><button class="btn">Simpan profil</button></form>
      <h2 id="pengaturan">Pengaturan akun</h2><form id="pw"><label>Password baru<input name="a" type="password" minlength="8" required></label><label>Konfirmasi<input name="b" type="password" required></label><button class="btn ghost">Ganti password</button></form></div>`;
      $('#pf').onsubmit = async e => { e.preventDefault(); const n = new FormData(e.target).get('n').trim(); if (n.length < 2) return toast('Nama terlalu pendek', 1); const { error } = await sb.from('profiles').update({ full_name: n }).eq('id', u.id); toast(error ? error.message : 'Profil disimpan', !!error); };
      $('#pw').onsubmit = async e => { e.preventDefault(); const f = new FormData(e.target); if (f.get('a').length < 8) return toast('Password minimal 8 karakter', 1); if (f.get('a') != f.get('b')) return toast('Konfirmasi tidak cocok', 1); const { error } = await sb.auth.updateUser({ password: f.get('a') }); toast(error ? error.message : 'Password diganti', !!error); e.target.reset(); };
    }
  } catch (e) { app.innerHTML = `<div class="state err"><p>Gagal memuat: ${esc(e.message)}</p><button class="btn sm" onclick="location.reload()">Coba lagi</button></div>`; }
  icons();
}
if (u) main();

}
async function P_reader() {
const location = __loc;
const id = new URLSearchParams(location.search).get('id'), u = await me();
const S = Object.assign({ fs: 18, ff: 'Georgia,serif', lh: 1.8, w: 680, th: 'light' }, JSON.parse(localStorage.getItem('nb_rs') || '{}'));
const key = 'nb_pos_' + id + '_' + (u?.id || 'anon'), doc = $('#doc'); let heads = [], tmr;
const apply = () => { document.body.dataset.th = S.th; doc.style.cssText = `font-size:${S.fs}px;font-family:${S.ff};line-height:${S.lh};max-width:${S.w}px`; localStorage.setItem('nb_rs', JSON.stringify(S)); };
const ratio = () => Math.min(1, scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight));
const goto = r => scrollTo({ top: r * (document.documentElement.scrollHeight - innerHeight) });
const clean = h => { const t = document.createElement('template'); t.innerHTML = h; t.content.querySelectorAll('script,iframe,object,embed,link,style,form').forEach(n => n.remove()); t.content.querySelectorAll('*').forEach(n => [...n.attributes].forEach(a => { if (/^on/i.test(a.name) || /^\s*javascript:/i.test(a.value)) n.removeAttribute(a.name); })); return t.content; };
const msg = (t, link) => { $('#app').innerHTML = `<div class="state"><p>${t}</p>${link || ''}<a class="btn ghost sm" href="catalog.html">Kembali ke katalog</a></div>`; };

async function init() {
  if (!id) return msg('Ebook tidak ditentukan.');
  const { data, error } = await sb.functions.invoke('read-book', { body: { book_id: id } });
  if (error || !data?.html) {
    const st = error?.context?.status;
    return st == 401 ? msg('Masuk dulu untuk membaca ebook ini.', `<a class="btn sm" href="login.html?next=${encodeURIComponent('reader.html?id=' + id)}">Login</a>`) : st == 403 ? msg('Ebook premium ini belum kamu miliki.', `<a class="btn sm" href="book.html?id=${id}#beli">Lihat pembelian</a>`) : msg('Ebook tidak dapat dimuat' + (error ? ': ' + esc(error.message) : '.'));
  }
  $('#ttl').textContent = data.title || 'Ebook'; document.title = (data.title || 'Ebook') + ' – NEXT BETTER';
  doc.replaceChildren(clean(data.html)); apply(); u && sb.rpc('register_read', { p_book_id: id });
  heads = [...doc.querySelectorAll('h1,h2,h3')].map((h, i) => (h.id = 'h' + i, h));
  $('#toc').innerHTML = heads.map(h => `<a href="#${h.id}" class="l${h.tagName[1]}">${esc(h.textContent)}</a>`).join('') || '<p class="mut">Tidak ada heading.</p>';
  let pos = +localStorage.getItem(key) || 0;
  if (u) { const { data: p } = await sb.from('reading_progress').select('position').eq('user_id', u.id).eq('book_id', id).maybeSingle(); if (p) pos = p.position; }
  if (pos > .01) { goto(pos); $('#last').hidden = false; $('#last').onclick = () => goto(pos); }
  bms(); icons();
}
const cur = () => { let c = null; heads.forEach(h => { if (h.getBoundingClientRect().top < 120) c = h; }); return c; };
window.__sc = () => {
  const r = ratio(); $('#pb').style.width = r * 100 + '%'; localStorage.setItem(key, r);
  clearTimeout(tmr); tmr = setTimeout(() => u && sb.from('reading_progress').upsert({ user_id: u.id, book_id: id, position: r, completed: r > .97, updated_at: new Date().toISOString() }), 2000);
};
addEventListener('scroll', window.__sc);
const panel = n => { document.querySelectorAll('.pnl').forEach(p => p.hidden = p.id != n || !p.hidden); };
document.querySelectorAll('[data-p]').forEach(b => b.onclick = () => panel(b.dataset.p));
const step = d => { const c = cur(), i = heads.indexOf(c) + d; if (heads[i]) heads[i].scrollIntoView(); };
$('#prev').onclick = () => step(-1); $('#next').onclick = () => step(1);
$('#toc').onclick = () => $('#tocp').hidden = true;
$('#fs').oninput = e => { S.fs = +e.target.value; apply(); }; $('#lh').oninput = e => { S.lh = +e.target.value; apply(); }; $('#wd').oninput = e => { S.w = +e.target.value; apply(); };
$('#ff').onchange = e => { S.ff = e.target.value; apply(); };
document.querySelectorAll('[data-th]').forEach(b => b.onclick = () => { S.th = b.dataset.th; apply(); });
$('#full').onclick = () => document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen?.();
$('#sq').oninput = e => {
  const t = e.target.value.trim().toLowerCase(), out = $('#sr'); if (t.length < 3) return out.innerHTML = '<p class="mut">Ketik minimal 3 huruf.</p>';
  const hits = [...doc.querySelectorAll('p,li,h1,h2,h3')].filter(n => n.textContent.toLowerCase().includes(t)).slice(0, 30);
  out.innerHTML = hits.map((n, i) => `<button data-i="${i}">${esc(n.textContent.slice(0, 90))}…</button>`).join('') || '<p class="mut">Tidak ditemukan.</p>';
  out.onclick = ev => { const i = ev.target.dataset.i; if (i == null) return; const n = hits[i]; n.scrollIntoView({ block: 'center' }); n.classList.add('hit'); setTimeout(() => n.classList.remove('hit'), 2000); };
};
async function bms() {
  if (!u) return $('#bl').innerHTML = '<p class="mut">Login untuk memakai bookmark.</p>';
  const { data } = await sb.from('bookmarks').select('*').eq('user_id', u.id).eq('book_id', id).order('created_at');
  $('#bl').innerHTML = (data || []).map(b => `<div class="bmk"><button data-r="${b.position}">${esc(b.label)}</button><button data-d="${b.id}" aria-label="Hapus bookmark">✕</button></div>`).join('') || '<p class="mut">Belum ada bookmark.</p>';
  $('#bl').onclick = async e => { if (e.target.dataset.r) goto(+e.target.dataset.r); if (e.target.dataset.d) { await sb.from('bookmarks').delete().eq('id', e.target.dataset.d); bms(); } };
}
$('#addbm').onclick = async () => {
  if (!u) return toast('Login untuk menambah bookmark', 1);
  const c = cur(), { error } = await sb.from('bookmarks').insert({ user_id: u.id, book_id: id, position: ratio(), label: (c?.textContent || 'Posisi ' + Math.round(ratio() * 100) + '%').slice(0, 80) });
  error ? toast(error.message, 1) : (toast('Bookmark ditambahkan'), bms());
};
init();

}
async function P_admin() {
const location = __loc;
const app = $('#app'), u = await me();
if (!u || !(await isAdmin(u))) {
  app.innerHTML = `<div class="deny"><h1>Akses ditolak</h1><p>Halaman ini hanya untuk akun admin terdaftar.</p><a class="btn" href="${u ? 'index.html' : 'login.html?next=admin.html'}">${u ? 'Kembali ke beranda' : 'Login'}</a></div>`; icons();
} else setTimeout(main);

const q = async p => { const { data, error } = await p; if (error) { console.warn(error.message); return []; } return data || []; };
const D = {}, empty = '<p class="mut">Belum ada data.</p>', PAL = ['#d1a954', '#8f93a8', '#5f9e7a', '#8b7bd0', '#c9bfa9'];
const SEC = [['overview', 'layout-dashboard', 'Dashboard'], ['analytics', 'chart-no-axes-column', 'Analytics'], ['books', 'book-open', 'Manajemen Ebook'], ['categories', 'tags', 'Kategori'], ['users', 'users', 'Manajemen Pengguna'], ['transactions', 'receipt', 'Manajemen Transaksi'], ['payments', 'credit-card', 'Pembayaran'], ['reports', 'file-text', 'Laporan'], ['settings', 'settings', 'Pengaturan Website'], ['notifications', 'bell', 'Notifikasi'], ['help', 'circle-help', 'Bantuan']];
const ICONS = ['briefcase', 'chart-line', 'brain', 'brain-circuit', 'cpu', 'graduation-cap', 'clock', 'heart-pulse', 'megaphone', 'users', 'lightbulb', 'book-open', 'palette', 'globe', 'camera', 'music', 'rocket', 'scale'];
const slug = s => s.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const months = n => { const a = [], d = new Date(); for (let i = n - 1; i >= 0; i--) { const x = new Date(d.getFullYear(), d.getMonth() - i, 1); a.push(x.getFullYear() + '-' + String(x.getMonth() + 1).padStart(2, '0')); } return a; };
const byMonth = (rows, n, f = () => 1, d = 'created_at') => months(n).map(m => [m, rows.filter(r => (r[d] || '').startsWith(m)).reduce((s, r) => s + f(r), 0)]);
const csv = (name, rows) => { const t = rows.map(r => r.map(v => { v = String(v ?? ''); if (/^[=+\-@]/.test(v)) v = "'" + v; return '"' + v.replace(/"/g, '""') + '"'; }).join(',')).join('\n'); const a = document.createElement('a'); a.href = URL.createObjectURL(new Blob(['\ufeff' + t], { type: 'text/csv' })); a.download = name; a.click(); };
const donut = rows => { const t = rows.reduce((s, r) => s + r[1], 0); if (!t) return empty; const c = 2 * Math.PI * 40; let a = 0; return `<div class="dnw"><svg viewBox="0 0 120 120" role="img" aria-label="Donut chart">${rows.map((x, i) => { const l = x[1] / t * c, s = `<circle cx="60" cy="60" r="40" fill="none" stroke="${PAL[i % 5]}" stroke-width="18" stroke-dasharray="${l} ${c - l}" stroke-dashoffset="${-a}" transform="rotate(-90 60 60)"><title>${esc(x[0])}: ${x[1]}</title></circle>`; a += l; return s; }).join('')}</svg><ul class="lg">${rows.map((x, i) => `<li><i style="background:${PAL[i % 5]}"></i>${esc(x[0])} <b>${x[1]}</b></li>`).join('')}</ul></div>`; };
const hbar = rows => rows.length ? (m => rows.map(r => `<div class="hb"><span>${esc(r[0])}</span><div><i style="width:${r[1] / m * 100}%" title="${r[1]}"></i></div><b>${r[1]}</b></div>`).join(''))(Math.max(1, ...rows.map(r => r[1]))) : empty;
const vbar = (rows, fm = x => x) => { const m = Math.max(1, ...rows.map(r => r[1])), w = 300 / rows.length; if (!rows.some(r => r[1])) return empty; return `<svg viewBox="0 0 300 130" class="vb" role="img" aria-label="Bar chart">${rows.map((r, i) => { const h = r[1] / m * 100; return `<rect x="${i * w + 3}" y="${105 - h}" width="${w - 6}" height="${h}" rx="3" fill="#d1a954"><title>${r[0]}: ${fm(r[1])}</title></rect><text x="${i * w + w / 2}" y="122" font-size="8" text-anchor="middle" fill="#85857F">${r[0].slice(5)}</text>`; }).join('')}</svg>`; };
const line = rows => { const m = Math.max(1, ...rows.map(r => r[1])); if (!rows.some(r => r[1])) return empty; const p = rows.map((r, i) => [10 + i * (280 / Math.max(1, rows.length - 1)), 105 - r[1] / m * 95]); return `<svg viewBox="0 0 300 130" class="vb" role="img" aria-label="Line chart"><polyline fill="none" stroke="#d1a954" stroke-width="2" points="${p.map(x => x.join(',')).join(' ')}"/>${p.map((x, i) => `<circle cx="${x[0]}" cy="${x[1]}" r="3.5" fill="#d1a954"><title>${rows[i][0]}: ${rows[i][1]}</title></circle><text x="${x[0]}" y="124" font-size="8" text-anchor="middle" fill="#85857F">${rows[i][0].slice(5)}</text>`).join('')}</svg>`; };
const funnel = rows => rows.map((r, i) => `<div class="fn" style="width:${100 - i * 15}%"><span>${r[0]}</span><b>${r[1]}</b></div>`).join('');

async function load() {
  [D.books, D.cats, D.users, D.pur, D.prog] = await Promise.all([q(sb.from('books').select('*,categories(name)').order('created_at', { ascending: false })), q(sb.from('categories').select('*').order('sort_order')), q(sb.from('profiles').select('*').order('created_at', { ascending: false })), q(sb.from('purchases').select('*').order('created_at', { ascending: false })), q(sb.from('reading_progress').select('*'))]);
  D.bk = id => D.books.find(b => b.id == id); D.us = id => D.users.find(x => x.id == id);
}
async function main() {
  $('#side').innerHTML = `<a class="logo" href="index.html"><i data-lucide="book-open"></i><span><b>NEXT BETTER</b><small>READ. LEARN. GROW.</small></span></a>` + SEC.map(s => `<a href="#/admin/${s[0]}" data-s="${s[0]}"><i data-lucide="${s[1]}"></i>${s[2]}${s[0] == 'notifications' ? '<em id="nb2"></em>' : ''}</a>`).join('') + `<div class="sp"></div><a href="index.html"><i data-lucide="arrow-left"></i>Ke website</a><button id="lt" class="lt"><i data-lucide="moon"></i>Mode terang</button>`;
  $('#amenu').onclick = () => $('#side').classList.toggle('open'); $('#side').onclick = () => $('#side').classList.remove('open');
  await load(); ME.name = D.users.find(x => x.id == u.id)?.full_name || u.email.split('@')[0]; $('#nm').textContent = ME.name; $('#ma').textContent = ME.name[0].toUpperCase();
  const n24 = events().filter(e => Date.now() - new Date(e[0]) < 864e5).length; ['#bd', '#nb2'].forEach(x => { const e = $(x); if (e && n24) e.textContent = n24 > 9 ? '9+' : n24; });
  $('#bell').onclick = () => window.location.hash = '#/admin/notifications'; $('#lt').onclick = () => document.body.toggleAttribute('data-light');
  $('#gq').onkeydown = e => { if (e.key == 'Enter') { window.GQ = e.target.value; window.location.hash == '#/admin/books' ? route() : window.location.hash = '#/admin/books'; } };
  addEventListener('keydown', e => { if ((e.ctrlKey || e.metaKey) && e.key == 'k') { e.preventDefault(); $('#gq')?.focus(); } });
  window.__adminRoute = route; route();
}
function route() {
  const s = SEC.find(x => x[0] == (window.location.hash.split('/')[2] || 'overview')) || SEC[0];
  document.querySelectorAll('#side a[data-s]').forEach(a => a.classList.toggle('on', a.dataset.s == s[0]));
  $('#crumb').innerHTML = `Admin / <b>${s[2]}</b>`; document.title = s[2] + ' – Admin NEXT BETTER';
  $('#main').onclick = null; ({ overview, analytics, books, categories, users, transactions, payments, reports, settings, notifications, help })[s[0]](); icons();
}
function analytics() {
  const paid = D.pur.filter(p => p.status == 'paid'), rev = paid.reduce((s, p) => s + Number(p.amount || 0), 0), now = months(1)[0];
  const act = new Set(D.prog.filter(p => Date.now() - new Date(p.updated_at) < 30 * 864e5).map(p => p.user_id)), rd = new Set(D.prog.map(p => p.user_id));
  const K = [['users', 'Total pengguna', D.users.length, D.users.filter(x => (x.created_at || '').startsWith(now)).length + ' baru bulan ini'], ['book-open', 'Total ebook', D.books.length, 'semua status'], ['book-check', 'Ebook gratis', D.books.filter(b => !b.is_premium).length, 'semua status'], ['crown', 'Ebook premium', D.books.filter(b => b.is_premium).length, 'semua status'], ['shopping-cart', 'Total pembelian', paid.length, 'status paid'], ['wallet', 'Total pendapatan', rp(rev), 'status paid'], ['book-open-text', 'Total pembaca', rd.size, 'punya progres baca'], ['activity', 'Pengguna aktif', act.size, '30 hari terakhir']];
  $('#main').innerHTML = `<div class="kpis">${K.map(k => `<div class="kp"><i data-lucide="${k[0]}"></i><span>${k[1]}</span><b>${k[2]}</b><small>${k[3]}</small></div>`).join('')}</div>
  <div class="tb"><label>Periode <select id="per"><option value="3">3 bulan</option><option value="6" selected>6 bulan</option><option value="12">12 bulan</option></select></label></div><div class="cg" id="cg"></div>`;
  const draw = () => {
    const n = +$('#per').value, st = ['pending', 'paid', 'failed', 'refunded'].map(s => [s, D.pur.filter(p => p.status == s).length]).filter(x => x[1]);
    const cat = D.cats.map(c => [c.name, D.books.filter(b => b.category_id == c.id).length]).filter(x => x[1]).sort((a, b) => b[1] - a[1]);
    const top = D.books.map(b => [b.title, paid.filter(p => p.book_id == b.id).length]).filter(x => x[1]).sort((a, b) => b[1] - a[1]).slice(0, 5);
    const day = Array.from({ length: 28 }, (_, i) => { const d = new Date(Date.now() - (27 - i) * 864e5).toISOString().slice(0, 10); return D.prog.filter(p => (p.updated_at || '').startsWith(d)).length; }), mx = Math.max(1, ...day);
    const C = [['Pertumbuhan pengguna', 'Pendaftar baru per bulan', line(byMonth(D.users, n))], ['Pendapatan', 'Total paid per bulan', vbar(byMonth(paid, n, p => Number(p.amount || 0)), rp)], ['Statistik pembelian', 'Jumlah transaksi paid per bulan', vbar(byMonth(paid, n))], ['Gratis vs premium', 'Komposisi ebook', donut([['Gratis', D.books.filter(b => !b.is_premium).length], ['Premium', D.books.filter(b => b.is_premium).length]])], ['Status transaksi', 'Seluruh transaksi', donut(st)], ['Kategori', 'Jumlah ebook per kategori', hbar(cat)], ['Ebook terlaris', 'Berdasarkan pembelian paid', hbar(top)], ['Aktivitas membaca', '28 hari terakhir (update progres)', `<div class="hmp">${day.map((v, i) => `<i style="opacity:${.12 + v / mx * .88}" title="${v} aktivitas"></i>`).join('')}</div>`], ['Konversi', 'Pengguna → pembaca → pembeli', funnel([['Pengguna', D.users.length], ['Pembaca', new Set(D.prog.map(p => p.user_id)).size], ['Pembeli', new Set(paid.map(p => p.user_id)).size]])]];
    $('#cg').innerHTML = C.map(c => `<section class="pn"><h3>${c[0]}</h3><p class="mut">${c[1]}</p>${c[2]}</section>`).join('');
  };
  $('#per').onchange = draw; draw();
}
function books() {
  $('#main').innerHTML = `<div class="tb"><input id="sq" type="search" placeholder="Cari ebook" value="${esc(window.GQ || '')}" aria-label="Cari ebook"><select id="sf" aria-label="Status"><option value="">Semua status</option><option>draft</option><option>published</option><option>archived</option></select><select id="ba" aria-label="Aksi massal"><option value="">Aksi massal…</option><option value="published">Publikasikan</option><option value="archived">Arsipkan</option><option value="del">Hapus</option></select><button class="btn sm" id="nb">+ Tambah ebook</button></div><div class="tw" id="bt"></div>`;
  const draw = () => {
    const t = $('#sq').value.toLowerCase(), s = $('#sf').value, l = D.books.filter(b => (!s || b.status == s) && (b.title + (b.author || '')).toLowerCase().includes(t));
    $('#bt').innerHTML = l.length ? `<table><tr><th></th><th>Judul</th><th>Kategori</th><th>Tipe</th><th>Harga</th><th>Status</th><th></th></tr>${l.map(b => `<tr><td><input type="checkbox" class="ck" value="${b.id}" aria-label="Pilih"></td><td>${esc(b.title)}<br><small>${esc(b.author || '')}</small></td><td>${esc(b.categories?.name || '-')}</td><td>${b.is_premium ? 'Premium' : 'Gratis'}</td><td>${b.is_premium ? rp(b.price) : '-'}</td><td><span class="tag ${b.status}">${b.status}</span></td><td class="ra"><a class="btn ghost sm" href="reader.html?id=${b.id}">Preview</a> <button class="btn ghost sm" data-e="${b.id}">Ubah</button> <button class="btn sm dg" data-x="${b.id}">Hapus</button></td></tr>`).join('')}</table>` : empty;
  };
  draw(); $('#sq').oninput = draw; $('#sf').onchange = draw; $('#nb').onclick = () => bookForm();
  $('#bt').onclick = async e => { if (e.target.dataset.e) bookForm(D.bk(e.target.dataset.e)); if (e.target.dataset.x && confirm('Hapus ebook ini?')) { const { error } = await sb.from('books').delete().eq('id', e.target.dataset.x); toast(error ? error.message : 'Ebook dihapus', !!error); await reload(); } };
  $('#ba').onchange = async e => { const ids = [...document.querySelectorAll('.ck:checked')].map(c => c.value), v = e.target.value; e.target.value = ''; if (!v || !ids.length) return toast('Pilih ebook dan aksi', 1); if (v == 'del' && !confirm('Hapus ' + ids.length + ' ebook?')) return; const { error } = v == 'del' ? await sb.from('books').delete().in('id', ids) : await sb.from('books').update({ status: v }).in('id', ids); toast(error ? error.message : 'Aksi massal selesai', !!error); await reload(); };
}
const reload = async () => { await load(); route(); };
function dlg(h) { let d = $('#dlg'); d.innerHTML = h; d.showModal(); $('[data-c]', d).onclick = () => d.close(); return d; }
function bookForm(b = {}) {
  const d = dlg(`<form id="bf"><h2>${b.id ? 'Ubah' : 'Tambah'} ebook</h2><label>Judul<input name="title" required value="${esc(b.title)}"></label><label>Penulis<input name="author" value="${esc(b.author)}"></label><label>Deskripsi<textarea name="description" rows="4">${esc(b.description)}</textarea></label>
  <div class="r2"><label>Kategori<select name="category_id"><option value="">-</option>${D.cats.map(c => `<option value="${c.id}" ${c.id == b.category_id ? 'selected' : ''}>${esc(c.name)}</option>`).join('')}</select></label><label>Tipe<select name="type"><option value="free">Gratis</option><option value="premium" ${b.is_premium ? 'selected' : ''}>Premium</option></select></label></div>
  <div class="r2"><label>Harga (Rp)<input name="price" type="number" min="0" value="${b.price || 0}"></label><label>Status<select name="status">${['draft', 'published', 'archived'].map(s => `<option ${s == (b.status || 'draft') ? 'selected' : ''}>${s}</option>`).join('')}</select></label></div>
  <label>Cover (gambar)<input name="cover" type="file" accept="image/*"></label><label>File ebook (.html)<input name="file" type="file" accept=".html,text/html"></label><div class="ra"><button type="button" class="btn ghost" data-c>Batal</button><button class="btn">Simpan</button></div></form>`);
  $('#bf').onsubmit = async e => {
    e.preventDefault(); const f = new FormData(e.target), r = { title: f.get('title').trim(), author: f.get('author').trim(), description: f.get('description'), category_id: f.get('category_id') || null, is_premium: f.get('type') == 'premium', price: Number(f.get('price')) || 0, status: f.get('status') };
    if (!r.title) return toast('Judul wajib diisi', 1); if (r.is_premium && r.price <= 0) return toast('Harga premium harus lebih dari 0', 1); if (!r.is_premium) r.price = 0;
    const up = async (bucket, file) => { const p = crypto.randomUUID() + '-' + file.name.replace(/[^\w.]/g, '_'); const { error } = await sb.storage.from(bucket).upload(p, file); if (error) throw error; return p; };
    try {
      const cv = f.get('cover'), fl = f.get('file');
      if (cv?.size) { const p = await up('book-covers', cv); r.cover_url = sb.storage.from('book-covers').getPublicUrl(p).data.publicUrl; }
      if (fl?.size) r.file_path = await up('book-files', fl);
      const { error } = b.id ? await sb.from('books').update(r).eq('id', b.id) : await sb.from('books').insert(r); if (error) throw error;
      d.close(); toast('Ebook disimpan'); reload();
    } catch (err) { toast(err.message, 1); }
  };
}
function categories() {
  $('#main').innerHTML = `<div class="tb"><button class="btn sm" id="nc">+ Tambah kategori</button></div><div class="tw">${D.cats.length ? `<table><tr><th>Ikon</th><th>Nama</th><th>Slug</th><th>Urutan</th><th>Ebook</th><th></th></tr>${D.cats.map(c => `<tr><td><i data-lucide="${esc(c.icon)}"></i></td><td>${esc(c.name)}<br><small>${esc(c.description || '')}</small></td><td>${esc(c.slug)}</td><td>${c.sort_order ?? ''}</td><td>${D.books.filter(b => b.category_id == c.id).length}</td><td class="ra"><button class="btn ghost sm" data-e="${c.id}">Ubah</button> <button class="btn sm dg" data-x="${c.id}">Hapus</button></td></tr>`).join('')}</table>` : empty}</div>`;
  $('#nc').onclick = () => catForm();
  $('#main').onclick = async e => { const t = e.target; if (t.dataset.e) catForm(D.cats.find(c => c.id == t.dataset.e)); if (t.dataset.x && confirm('Hapus kategori? Ebook di dalamnya kehilangan kategori.')) { const { error } = await sb.from('categories').delete().eq('id', t.dataset.x); toast(error ? error.message : 'Kategori dihapus', !!error); reload(); } };
}
function catForm(c = {}) {
  const d = dlg(`<form id="cf"><h2>${c.id ? 'Ubah' : 'Tambah'} kategori</h2><label>Nama<input name="name" required value="${esc(c.name)}"></label><label>Slug<input name="slug" value="${esc(c.slug)}" placeholder="otomatis dari nama"></label><label>Deskripsi<input name="description" value="${esc(c.description)}"></label><label>Urutan tampil<input name="sort_order" type="number" value="${c.sort_order ?? D.cats.length + 1}"></label>
  <label>Ikon<select name="icon">${ICONS.map(i => `<option ${i == c.icon ? 'selected' : ''}>${i}</option>`).join('')}</select></label><div class="ra"><button type="button" class="btn ghost" data-c>Batal</button><button class="btn">Simpan</button></div></form>`);
  $('#cf').onsubmit = async e => { e.preventDefault(); const f = new FormData(e.target), r = { name: f.get('name').trim(), slug: slug(f.get('slug') || f.get('name')), description: f.get('description'), sort_order: +f.get('sort_order') || 0, icon: f.get('icon') }; if (!r.name) return toast('Nama wajib diisi', 1); const { error } = c.id ? await sb.from('categories').update(r).eq('id', c.id) : await sb.from('categories').insert(r); if (error) return toast(error.message, 1); d.close(); toast('Kategori disimpan'); reload(); };
}
function users() {
  $('#main').innerHTML = `<div class="tb"><input id="uq" type="search" placeholder="Cari nama atau email" aria-label="Cari pengguna"></div><div class="tw" id="ut"></div><div id="ud"></div>`;
  const draw = () => { const t = $('#uq').value.toLowerCase(), l = D.users.filter(x => ((x.full_name || '') + (x.email || '')).toLowerCase().includes(t)); $('#ut').innerHTML = l.length ? `<table><tr><th>Nama</th><th>Email</th><th>Terdaftar</th><th>Ebook dimiliki</th><th>Aktivitas terakhir</th><th></th></tr>${l.map(x => { const ps = D.prog.filter(p => p.user_id == x.id).map(p => p.updated_at).sort().pop(); return `<tr><td>${esc(x.full_name || '-')}</td><td>${esc(x.email || '-')}</td><td>${(x.created_at || '').slice(0, 10)}</td><td>${D.pur.filter(p => p.user_id == x.id && p.status == 'paid').length}</td><td>${ps ? ps.slice(0, 10) : '-'}</td><td><button class="btn ghost sm" data-u="${x.id}">Detail</button></td></tr>`; }).join('')}</table>` : empty; };
  draw(); $('#uq').oninput = draw;
  $('#ut').onclick = e => { const id = e.target.dataset.u; if (!id) return; const x = D.us(id); $('#ud').innerHTML = `<section class="pn"><h3>${esc(x.full_name || x.email)}</h3><h4>Riwayat pembelian</h4>${D.pur.filter(p => p.user_id == id).map(p => `<div class="hb2">${esc(D.bk(p.book_id)?.title || '-')} · ${rp(p.amount)} · <span class="tag ${p.status}">${p.status}</span></div>`).join('') || empty}<h4>Riwayat membaca</h4>${D.prog.filter(p => p.user_id == id).map(p => `<div class="hb2">${esc(D.bk(p.book_id)?.title || '-')} · ${Math.round(p.position * 100)}%</div>`).join('') || empty}</section>`; };
}
function transactions() {
  $('#main').innerHTML = `<div class="tb"><input id="tq" type="search" placeholder="Cari ID, pengguna, ebook" aria-label="Cari transaksi"><select id="ts" aria-label="Status"><option value="">Semua status</option><option>pending</option><option>paid</option><option>failed</option><option>refunded</option></select><button class="btn sm" id="ex">Ekspor CSV</button></div><p class="mut">Status hanya berubah lewat verifikasi backend (webhook payment gateway), bukan dari halaman ini.</p><div class="tw" id="tt"></div>`;
  const rows = () => { const t = $('#tq').value.toLowerCase(), s = $('#ts').value; return D.pur.filter(p => (!s || p.status == s) && [p.id, D.us(p.user_id)?.email, D.bk(p.book_id)?.title].join(' ').toLowerCase().includes(t)); };
  const draw = () => { const l = rows(); $('#tt').innerHTML = l.length ? `<table><tr><th>ID</th><th>Pengguna</th><th>Ebook</th><th>Jumlah</th><th>Metode</th><th>Tanggal</th><th>Status</th></tr>${l.map(p => `<tr><td><small>${esc(p.id)}</small></td><td>${esc(D.us(p.user_id)?.email || p.user_id)}</td><td>${esc(D.bk(p.book_id)?.title || '-')}</td><td>${rp(p.amount)}</td><td>${esc(p.payment_method || '-')}</td><td>${(p.created_at || '').slice(0, 10)}</td><td><span class="tag ${p.status}">${p.status}</span></td></tr>`).join('')}</table>` : empty; };
  draw(); $('#tq').oninput = draw; $('#ts').onchange = draw;
  $('#ex').onclick = () => csv('transaksi.csv', [['id', 'email', 'ebook', 'jumlah', 'metode', 'tanggal', 'status'], ...rows().map(p => [p.id, D.us(p.user_id)?.email, D.bk(p.book_id)?.title, p.amount, p.payment_method, p.created_at, p.status])]);
}
async function settings() {
  const K = [['site_name', 'Nama website'], ['tagline', 'Slogan'], ['contact', 'Kontak (tampil di halaman Kontak)'], ['instagram', 'Instagram (URL https)'], ['youtube', 'YouTube (URL https)'], ['x', 'X (URL https)'], ['about', 'Tentang Kami'], ['privacy_policy', 'Kebijakan Privasi'], ['terms', 'Syarat dan Ketentuan']];
  const S = Object.fromEntries((await q(sb.from('website_settings').select('*'))).map(r => [r.key, r.value]));
  $('#main').innerHTML = `<form id="sf" class="pn">${K.map(k => `<label>${k[1]}<textarea name="${k[0]}" rows="${k[0].length > 7 ? 4 : 1}">${esc(S[k[0]])}</textarea></label>`).join('')}<button class="btn">Simpan pengaturan</button></form><p class="mut">Logo, warna brand, banner homepage, dan pengelola newsletter belum terintegrasi (butuh upload ke Storage dan penerapan tema).</p>`;
  $('#sf').onsubmit = async e => { e.preventDefault(); const f = new FormData(e.target), r = K.map(k => ({ key: k[0], value: f.get(k[0]).trim() })); const { error } = await sb.from('website_settings').upsert(r); toast(error ? error.message : 'Pengaturan disimpan', !!error); };
}

/* ---------- Dashboard baru, pembayaran, laporan, notifikasi, bantuan ---------- */
const ME = { name: '' };
const ago = d => { const x = (Date.now() - new Date(d)) / 1000; return x < 60 ? 'baru saja' : x < 3600 ? Math.floor(x / 60) + ' menit yang lalu' : x < 86400 ? Math.floor(x / 3600) + ' jam yang lalu' : Math.floor(x / 86400) + ' hari yang lalu'; };
const inP = (rows, d, off = 0) => rows.filter(r => { const t = Date.now() - new Date(r.created_at); return t >= off * 864e5 && t < (off + d) * 864e5; });
const pct = (a, b) => b ? Math.round((a - b) / b * 100) : null;
const chg = p => p == null ? '<em>belum ada pembanding</em>' : `<em class="${p >= 0 ? 'up' : 'dn'}">${p >= 0 ? '↑' : '↓'} ${Math.abs(p)}%</em>`;
const spark = (rows, d, f) => { const n = 12, st = d * 864e5 / n, s0 = Date.now() - d * 864e5, v = Array.from({ length: n }, (_, i) => rows.filter(r => { const t = +new Date(r.created_at); return t > s0 + i * st && t <= s0 + (i + 1) * st; }).reduce((a, r) => a + f(r), 0)), m = Math.max(1, ...v), p = v.map((y, i) => `${i * 100 / (n - 1)},${38 - y / m * 34}`).join(' '); return `<svg class="sp" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><polygon points="0,40 ${p} 100,40" fill="currentColor" opacity=".18"/><polyline points="${p}" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>`; };
const events = () => [...D.users.map(x => [x.created_at, 'user-plus', 'Pengguna baru mendaftar', x.full_name || x.email || '']), ...D.pur.map(p => [p.created_at, p.status == 'paid' ? 'badge-check' : p.status == 'failed' ? 'circle-x' : 'shopping-cart', p.status == 'paid' ? 'Pembayaran berhasil' : p.status == 'failed' ? 'Pembayaran gagal' : 'Pembelian baru (' + p.status + ')', (D.bk(p.book_id)?.title || '-') + ' · ' + rp(p.amount)]), ...D.books.map(b => [b.created_at, 'book-plus', 'Ebook baru ditambahkan', b.title])].filter(e => e[0]).sort((a, b) => new Date(b[0]) - new Date(a[0]));
const tl = l => `<ul class="tm">${l.map(e => `<li><span class="ic"><i data-lucide="${e[1]}"></i></span><div><b>${esc(e[2])}</b><small>${esc(e[3])}</small><small>${ago(e[0])}</small></div></li>`).join('') || '<p class="mut">Belum ada aktivitas.</p>'}</ul>`;
const combo = (u, r) => { if (!u.some(x => x[1]) && !r.some(x => x[1])) return empty; const mu = Math.max(1, ...u.map(x => x[1])), mr = Math.max(1, ...r.map(x => x[1])), w = 370 / u.length, cx = i => 24 + i * w + w / 2; return `<svg viewBox="0 0 400 185" class="vb" role="img" aria-label="Pengguna baru dan pendapatan">${u.map((x, i) => { const h = x[1] / mu * 125; return `<rect x="${cx(i) - w * .3}" y="${145 - h}" width="${w * .6}" height="${h}" rx="3" fill="#d1a954"><title>${x[0]}: ${x[1]} pengguna baru</title></rect><text x="${cx(i)}" y="165" font-size="9" text-anchor="middle" fill="#9a948a">${x[0].slice(5)}</text>`; }).join('')}<polyline fill="none" stroke="#f1ece2" stroke-width="2" points="${r.map((x, i) => `${cx(i)},${145 - x[1] / mr * 125}`).join(' ')}"/>${r.map((x, i) => `<circle cx="${cx(i)}" cy="${145 - x[1] / mr * 125}" r="3.5" fill="#f1ece2"><title>${x[0]}: ${rp(x[1])}</title></circle>`).join('')}</svg><p class="mut"><span style="color:#d1a954">■</span> Pengguna baru &nbsp; <span>●</span> Pendapatan</p>`; };
const donut2 = rows => { const t = rows.reduce((s, r) => s + r[1], 0); if (!t) return '<p class="mut">Belum ada data bacaan.</p>'; const c = 2 * Math.PI * 40; let a = 0; return `<div class="dnw"><svg viewBox="0 0 120 120" role="img" aria-label="Kategori terpopuler">${rows.map((x, i) => { const l = x[1] / t * c, e = `<circle cx="60" cy="60" r="40" fill="none" stroke="${PAL[i % 5]}" stroke-width="16" stroke-dasharray="${l} ${c - l}" stroke-dashoffset="${-a}" transform="rotate(-90 60 60)"><title>${esc(x[0])}: ${x[1]}</title></circle>`; a += l; return e; }).join('')}<text x="60" y="66" text-anchor="middle" font-size="16" font-weight="800" fill="currentColor">${Math.round(rows[0][1] / t * 100)}%</text></svg><ul class="lg">${rows.map((x, i) => `<li><i style="background:${PAL[i % 5]}"></i><span>${esc(x[0])}</span><b>${Math.round(x[1] / t * 100)}%</b></li>`).join('')}</ul></div>`; };
const thumb = b => b.cover_url ? `<img src="${esc(b.cover_url)}" alt="">` : '<span class="th0"></span>';
function overview() {
  const paid = D.pur.filter(p => p.status == 'paid'), amt = p => Number(p.amount || 0), rev = paid.reduce((s, p) => s + amt(p), 0), one = () => 1;
  $('#main').innerHTML = `<div class="wl"><div><h1>Selamat Datang, ${esc(ME.name)}!</h1><p class="mut">Berikut adalah ringkasan aktivitas platform NEXT BETTER.</p></div><select id="pd" aria-label="Periode"><option value="7">7 Hari Terakhir</option><option value="30">30 Hari Terakhir</option><option value="90">90 Hari Terakhir</option></select></div><div class="kk" id="kk"></div>
  <div class="og"><section class="pn"><div class="ph2"><h3>Analitik Platform</h3><select id="nm6" aria-label="Rentang bulan"><option value="3">3 Bulan Terakhir</option><option value="7" selected>7 Bulan Terakhir</option><option value="12">12 Bulan Terakhir</option></select></div><div id="pa"></div></section>
  <section class="pn"><div class="ph2"><h3>Kategori Terpopuler</h3><a href="#/admin/analytics">Lihat Semua →</a></div><div id="pc"></div></section><section class="pn"><div class="ph2"><h3>Ebook Paling Banyak Dibaca</h3><a href="#/admin/books">Lihat Semua →</a></div><div id="pt"></div></section></div>
  <div class="og2"><section class="pn"><div class="ph2"><h3>Transaksi Terbaru</h3><a href="#/admin/transactions">Lihat Semua →</a></div><div class="tw" id="tr"></div></section><section class="pn"><div class="ph2"><h3>Aktivitas Terbaru</h3><a href="#/admin/notifications">Lihat Semua →</a></div>${tl(events().slice(0, 5))}</section></div>`;
  const K = [['users', 'Total Pengguna', D.users.length, D.users, one, 'k1'], ['book-open', 'Total Ebook', D.books.length, D.books, one, 'k2'], ['wallet', 'Total Pendapatan', rp(rev), paid, amt, 'k3'], ['shopping-cart', 'Total Transaksi', D.pur.length, D.pur, one, 'k4']];
  const kk = () => { const d = +$('#pd').value; $('#kk').innerHTML = K.map(k => { const c = inP(k[3], d).reduce((s, r) => s + k[4](r), 0), p = inP(k[3], d, d).reduce((s, r) => s + k[4](r), 0); return `<div class="kc ${k[5]}"><i data-lucide="${k[0]}"></i><div><span>${k[1]}</span><b>${k[2]}</b>${chg(pct(c, p))}</div>${spark(k[3], d, k[4])}</div>`; }).join(''); icons(); };
  const an = () => { const n = +$('#nm6').value; $('#pa').innerHTML = combo(byMonth(D.users, n), byMonth(paid, n, amt)); };
  $('#pd').onchange = kk; $('#nm6').onchange = an; kk(); an();
  const cr = D.cats.map(c => [c.name, D.books.filter(b => b.category_id == c.id).reduce((s, b) => s + (b.read_count || 0), 0)]).filter(x => x[1]).sort((a, b) => b[1] - a[1]), top = cr.slice(0, 4), rest = cr.slice(4).reduce((s, x) => s + x[1], 0); if (rest) top.push(['Lainnya', rest]);
  $('#pc').innerHTML = donut2(top);
  $('#pt').innerHTML = [...D.books].filter(b => b.read_count > 0).sort((a, b) => b.read_count - a.read_count).slice(0, 5).map((b, i) => `<div class="rkl"><b>${i + 1}</b>${thumb(b)}<div>${esc(b.title)}<small>${esc(b.author || '')}</small></div><span>${b.read_count} dibaca</span></div>`).join('') || '<p class="mut">Belum ada data bacaan.</p>';
  $('#tr').innerHTML = D.pur.length ? `<table><tr><th>ID</th><th>Pengguna</th><th>Ebook</th><th>Jumlah</th><th>Status</th><th>Tanggal</th></tr>${D.pur.slice(0, 5).map(p => `<tr><td><small>${esc(String(p.id).slice(0, 8).toUpperCase())}</small></td><td>${esc(D.us(p.user_id)?.full_name || '-')}</td><td>${esc(D.bk(p.book_id)?.title || '-')}</td><td>${rp(p.amount)}</td><td><span class="tag ${p.status}">${p.status}</span></td><td>${(p.created_at || '').slice(0, 10)}</td></tr>`).join('')}</table>` : '<p class="mut" style="padding:12px">Belum ada transaksi.</p>';
}
function payments() {
  const S = ['paid', 'pending', 'failed', 'refunded'], sum = s => D.pur.filter(p => p.status == s).reduce((a, p) => a + Number(p.amount || 0), 0);
  $('#main').innerHTML = `<div class="kpis">${S.map(s => `<div class="kp"><span>${s}</span><b>${D.pur.filter(p => p.status == s).length}</b><small>${rp(sum(s))}</small></div>`).join('')}</div><div class="pn"><h3>Integrasi payment gateway</h3><p class="mut">Belum terhubung. Dibutuhkan Edge Function webhook yang memverifikasi tanda tangan gateway, mencegah pemrosesan ganda, lalu mengubah status transaksi menjadi paid. Setelah aktif, riwayat pembayaran tampil di bawah.</p></div><br><div class="tw">${D.pur.length ? `<table><tr><th>ID</th><th>Pengguna</th><th>Metode</th><th>Jumlah</th><th>Status</th><th>Tanggal</th></tr>${D.pur.slice(0, 50).map(p => `<tr><td><small>${esc(p.id)}</small></td><td>${esc(D.us(p.user_id)?.email || '-')}</td><td>${esc(p.payment_method || '-')}</td><td>${rp(p.amount)}</td><td><span class="tag ${p.status}">${p.status}</span></td><td>${(p.created_at || '').slice(0, 10)}</td></tr>`).join('')}</table>` : '<p class="mut" style="padding:14px">Belum ada pembayaran.</p>'}</div>`;
}
function reports() {
  const B = [['rev', 'Laporan pendapatan'], ['pur', 'Laporan pembelian'], ['usr', 'Laporan pengguna'], ['bk', 'Ebook populer'], ['cat', 'Kategori populer']];
  $('#main').innerHTML = `<div class="pn"><h3>Laporan</h3><div class="tb"><label>Dari <input type="date" id="d1"></label><label>Sampai <input type="date" id="d2"></label></div><div class="tb">${B.map(b => `<button class="btn" data-r="${b[0]}">⭳ ${b[1]} (CSV)</button>`).join('')}</div><p class="mut">Filter tanggal berlaku untuk pendapatan, pembelian, dan pengguna.</p></div>`;
  $('#main').onclick = e => {
    const r = e.target.dataset.r; if (!r) return; const a = $('#d1').value, b = $('#d2').value, ok = x => { const d = (x.created_at || '').slice(0, 10); return (!a || d >= a) && (!b || d <= b); };
    const T = { rev: [['tanggal', 'id', 'ebook', 'jumlah'], D.pur.filter(p => p.status == 'paid' && ok(p)).map(p => [p.created_at, p.id, D.bk(p.book_id)?.title, p.amount])], pur: [['tanggal', 'id', 'email', 'ebook', 'jumlah', 'status'], D.pur.filter(ok).map(p => [p.created_at, p.id, D.us(p.user_id)?.email, D.bk(p.book_id)?.title, p.amount, p.status])], usr: [['terdaftar', 'nama', 'email'], D.users.filter(ok).map(x => [x.created_at, x.full_name, x.email])], bk: [['judul', 'penulis', 'dibaca', 'terjual'], [...D.books].sort((x, y) => (y.read_count || 0) - (x.read_count || 0)).map(x => [x.title, x.author, x.read_count || 0, D.pur.filter(p => p.book_id == x.id && p.status == 'paid').length])], cat: [['kategori', 'ebook', 'dibaca'], D.cats.map(c => [c.name, D.books.filter(x => x.category_id == c.id).length, D.books.filter(x => x.category_id == c.id).reduce((s, x) => s + (x.read_count || 0), 0)])] }[r];
    csv('laporan-' + r + '.csv', [T[0], ...T[1]]);
  };
}
function notifications() { $('#main').innerHTML = `<div class="pn"><h3>Notifikasi</h3>${tl(events().slice(0, 25))}</div>`; }
function help() { $('#main').innerHTML = `<div class="pn"><h3>Bantuan</h3><ul class="hl"><li><b>Tambah ebook:</b> Manajemen Ebook › Tambah. Unggah file .html dengan heading h1–h3 agar daftar isi reader terbentuk otomatis.</li><li><b>Publikasi:</b> hanya ebook berstatus published yang tampil untuk pengunjung.</li><li><b>Akun admin:</b> tambahkan user_id ke tabel admin_users di Supabase; tidak ada akun admin di dalam kode.</li><li><b>Pembayaran:</b> status paid hanya boleh diubah backend (webhook), bukan dashboard ini.</li><li><b>Pengaturan:</b> nama, slogan, kontak, media sosial, dan kebijakan disimpan di tabel website_settings.</li></ul></div>`; }

}

const SHELL = {"index": "<header id=\"nav\"><\/header>\n<main class=\"wrap hm\"><section class=\"hero\"><div class=\"eb\">DIGITAL LIBRARY · NEXT BETTER<\/div><h1>Buku yang Menginspirasi<br><span class=\"gt\">Perjalananmu<\/span><\/h1><p>Temukan e-book terbaik untuk mengembangkan pola pikir, meningkatkan diri, dan meraih masa depan yang lebih baik.<\/p><form class=\"hs\" action=\"catalog.html\"><input name=\"q\" placeholder=\"Cari judul, penulis, atau kategori...\" aria-label=\"Cari ebook\"><button aria-label=\"Cari\"><i data-lucide=\"search\"><\/i><\/button><\/form><\/section>\n<aside class=\"promo\"><h3>BACA<br>LEBIH BANYAK<br><span class=\"gt\">JADI LEBIH BAIK<\/span><\/h3><p>Koleksi e-book berkualitas dalam satu tempat.<\/p><a class=\"btn\" href=\"catalog.html\" style=\"margin-top:16px\">Jelajahi Sekarang <i data-lucide=\"arrow-right\"><\/i><\/a><div class=\"bs\" aria-hidden=\"true\"><\/div><\/aside>\n<div><div class=\"ctabs\" id=\"ct\" role=\"tablist\" aria-label=\"Kategori\"><\/div><div id=\"kategori\" class=\"shd\"><div><span class=\"pill\">KOLEKSI PILIHAN<\/span><h2>E-book Terbaru<\/h2><p>Koleksi pilihan untuk menemani proses belajar dan berkembangmu.<\/p><\/div><div class=\"shr\"><span id=\"tot\"><\/span><select id=\"so\" aria-label=\"Urutkan\"><option value=\"new\">Terbaru<\/option><option value=\"pop\">Terpopuler<\/option><option value=\"az\">A–Z<\/option><\/select><\/div><\/div><div class=\"grid\" id=\"feat\"><\/div><p class=\"ctr\"><a class=\"btn ghost\" href=\"catalog.html\">Lihat semua ebook<\/a><\/p><\/div>\n<aside class=\"pop\"><div class=\"ph\"><h3 style=\"margin:0\"><i data-lucide=\"flame\" style=\"color:var(--gd);vertical-align:-3px\"><\/i> Buku Populer<\/h3><a href=\"catalog.html?sort=pop\">Lihat Semua →<\/a><\/div><div id=\"pl\"><\/div><\/aside><\/main><footer id=\"ft\"><\/footer>", "catalog": "<header id=\"nav\"><\/header><div id=\"bn\"><\/div><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "book": "<header id=\"nav\"><\/header><div id=\"bn\"><\/div><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "info": "<header id=\"nav\"><\/header><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "login": "<header id=\"nav\"><\/header><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "register": "<header id=\"nav\"><\/header><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "profile": "<header id=\"nav\"><\/header><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "my-books": "<header id=\"nav\"><\/header><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "dashboard": "<header id=\"nav\"><\/header><main id=\"app\" class=\"wrap main\"><div class=\"grid\"><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><div class=\"sk\"><\/div><\/div><\/main><footer id=\"ft\"><\/footer>", "reader": "<div id=\"app\">\n<div class=\"rb\"><div class=\"in\"><a class=\"ib\" href=\"catalog.html\" aria-label=\"Kembali ke katalog\" title=\"Kembali ke katalog\">←<\/a><b id=\"ttl\">Memuat…<\/b><button id=\"last\" hidden title=\"Kembali ke posisi terakhir\" aria-label=\"Kembali ke posisi terakhir\">⟲<\/button><button data-p=\"tocp\" title=\"Daftar isi\" aria-label=\"Daftar isi\">☰<\/button><button data-p=\"sp\" title=\"Cari\" aria-label=\"Cari\">⌕<\/button><button data-p=\"bp\" title=\"Bookmark\" aria-label=\"Bookmark\">🔖<\/button><button data-p=\"op\" title=\"Pengaturan\" aria-label=\"Pengaturan\">Aa<\/button><button id=\"full\" title=\"Layar penuh\" aria-label=\"Layar penuh\">⛶<\/button><\/div><div id=\"pbw\"><div id=\"pb\"><\/div><\/div><\/div>\n<div class=\"pnl\" id=\"tocp\" hidden><b>Daftar isi<\/b><div id=\"toc\"><\/div><\/div>\n<div class=\"pnl\" id=\"sp\" hidden><input id=\"sq\" type=\"search\" placeholder=\"Cari kata dalam ebook\" aria-label=\"Cari kata\"><div id=\"sr\"><\/div><\/div>\n<div class=\"pnl\" id=\"bp\" hidden><button class=\"btn\" id=\"addbm\">+ Tambah bookmark di sini<\/button><div id=\"bl\"><\/div><\/div>\n<div class=\"pnl\" id=\"op\" hidden><label>Ukuran font<input id=\"fs\" type=\"range\" min=\"14\" max=\"30\" value=\"18\"><\/label><label>Jenis font<select id=\"ff\"><option value=\"Georgia,serif\">Serif<\/option><option value=\"'Plus Jakarta Sans',system-ui,sans-serif\">Sans<\/option><option value=\"ui-monospace,monospace\">Mono<\/option><\/select><\/label><label>Jarak baris<input id=\"lh\" type=\"range\" min=\"1.3\" max=\"2.4\" step=\".1\" value=\"1.8\"><\/label><label>Lebar area<input id=\"wd\" type=\"range\" min=\"480\" max=\"960\" step=\"20\" value=\"680\"><\/label><div class=\"th\"><button data-th=\"light\">Light<\/button><button data-th=\"sepia\">Sepia<\/button><button data-th=\"dark\">Dark<\/button><\/div><\/div>\n<article id=\"doc\"><\/article><div class=\"nav2\"><button id=\"prev\">‹ Bab sebelumnya<\/button><button id=\"next\">Bab berikutnya ›<\/button><\/div><\/div>", "admin": "<div class=\"ad\"><aside id=\"side\" aria-label=\"Menu admin\"><\/aside><div><div class=\"top\"><button class=\"ib\" id=\"amenu\" aria-label=\"Menu\"><i data-lucide=\"menu\"><\/i><\/button><label class=\"gs\"><i data-lucide=\"search\"><\/i><input id=\"gq\" placeholder=\"Cari ebook, pengguna, atau transaksi...\" aria-label=\"Cari\"><kbd>Ctrl + K<\/kbd><\/label><div class=\"sp\"><\/div><button class=\"ib\" id=\"bell\" aria-label=\"Notifikasi\"><i data-lucide=\"bell\"><\/i><em id=\"bd\"><\/em><\/button><div class=\"me\"><span class=\"av\" id=\"ma\"><\/span><div><b id=\"nm\"><\/b><small>Administrator<\/small><\/div><\/div><\/div><div id=\"crumb\">Admin<\/div><main id=\"app\"><div id=\"main\"><div class=\"sk big\"><\/div><\/div><\/main><\/div><\/div><dialog id=\"dlg\"><\/dialog>"};
const ROUTE = { page: 'index', file: 'index.html', search: '', anchor: '', recovery: RECOVERY };
const PAGES = { index: P_books, catalog: P_books, book: P_books, info: P_books, login: P_auth, register: P_auth, profile: P_dashboard, 'my-books': P_dashboard, dashboard: P_dashboard, reader: P_reader, admin: P_admin };
function nav(u) { const m = /^([a-z-]+)\.html(\?[^#]*)?(#(.*))?$/i.exec(u || ''); if (!m) { window.location.hash = u; return; } window.location.hash = '#/' + m[1] + (m[2] || '') + (m[4] ? '~' + m[4] : ''); }
let CUR = null;
async function render() {
  window.__sc && removeEventListener('scroll', window.__sc); window.__sc = null;
  const raw = window.location.hash, ok = raw.startsWith('#/'); let h = ok ? raw.slice(2) : '';
  const ai = h.indexOf('~'), anchor = ai < 0 ? '' : h.slice(ai + 1); if (ai >= 0) h = h.slice(0, ai);
  const qi = h.indexOf('?'), qs = qi < 0 ? '' : h.slice(qi), path = qi < 0 ? h : h.slice(0, qi); let page = path.split('/')[0];
  if (!PAGES[page]) page = (!ok && ROUTE.recovery) ? 'login' : 'index';
  ROUTE.anchor = anchor; const key = page + qs;
  if (key === CUR) { page === 'admin' ? (window.__adminRoute && window.__adminRoute()) : anchor && document.getElementById(anchor)?.scrollIntoView({ behavior: 'smooth' }); return; }
  CUR = key; Object.assign(ROUTE, { page, file: page + '.html', search: qs });
  document.body.dataset.page = page; document.body.className = page === 'reader' ? 'rdr' : ''; document.body.removeAttribute('data-th');
  $('#root').innerHTML = SHELL[page]; if (!anchor) scrollTo(0, 0);
  try { await PAGES[page](); } catch (e) { console.error(e); const a = $('#app'); a && (a.innerHTML = '<div class="state err"><p>Terjadi kesalahan: ' + esc(e.message) + '</p></div>'); }
  anchor && document.getElementById(anchor)?.scrollIntoView(); icons();
}
document.addEventListener('click', e => { const a = e.target.closest && e.target.closest('a[href]'); if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || a.target === '_blank') return; const h = a.getAttribute('href'); if (/^[a-z-]+\.html(\?[^#]*)?(#.*)?$/i.test(h)) { e.preventDefault(); nav(h); } });
document.addEventListener('submit', e => { const f = e.target, a = f.getAttribute && f.getAttribute('action'); if (a && /^[a-z-]+\.html$/i.test(a)) { e.preventDefault(); const q = new URLSearchParams(new FormData(f)).toString(); nav(a + (q ? '?' + q : '')); } });
addEventListener('hashchange', render); render();

</script></body></html>
